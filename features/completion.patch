+
+    def test_pause_during_large_file_discards_partial_output_and_resumes(self):
+        large = self.source / "00-large.bin"
+        large.write_bytes(b"0123456789abcdef" * (archives.CHUNK_BYTES // 8))
+        self.pack()
+        ledger = self.root / "copy.sqlite"
+        virtual = self.package / self.project["backupRelativePath"]
+        original = archives._member_chunks
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint:
+            def pause_in_file(archive, entry):
+                for chunk in original(archive, entry):
+                    yield chunk
+                    checkpoint.request_pause()
+            with patch.object(archives, "_member_chunks", pause_in_file):
+                with self.assertRaises(RestorePaused):
+                    self.extract(checkpoint=checkpoint)
+            self.assertEqual(checkpoint.summary()["files"], 0)
+        self.assertFalse((self.destination / large.name).exists())
+        self.assertFalse(list(self.destination.rglob(archives.TEMP_PREFIX + "*")))
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint:
+            self.extract(checkpoint=checkpoint)
+        self.assertEqual((self.destination / large.name).read_bytes(), large.read_bytes())
+        archives.verify_metadata(self.package, self.project, self.destination)
+
+    def test_checkpoint_flush_failure_does_not_hide_original_pause(self):
+        self.pack()
+        with CopyCheckpoint(self.root / "copy.sqlite",
+                            self.package / self.project["backupRelativePath"], self.destination) as checkpoint:
+            checkpoint.request_pause()
