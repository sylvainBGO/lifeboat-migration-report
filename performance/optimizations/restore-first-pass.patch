@@ -0,0 +1,146 @@
+"""Pinned baseline/candidate comparison in separate Windows processes.
+
+Only synthetic profiles under the explicitly created test root are accepted.
+Runs ABBA order; reports raw samples, not a forecast for the real backup.
+"""
+import argparse
+import importlib
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+from unittest.mock import patch
+
+
+def save(path, data):
+    path.write_text(json.dumps(data, indent=2), encoding='utf-8')
+
+
+def isolated(root):
+    for key in ('LOCALAPPDATA', 'APPDATA', 'TEMP', 'TMP'):
+        directory = root / key
+        directory.mkdir(parents=True, exist_ok=True)
+        os.environ[key] = str(directory)
+    tempfile.tempdir = str(root / 'TEMP')
+
+
+def worker(args):
+    sys.path.insert(0, str(Path(args.source).resolve()))
+    root = Path(args.root).resolve()
+    if not (root / 'synthetic-owner.json').is_file():
+        raise RuntimeError('Not a synthetic fixture')
+    isolated(root / args.tag)
+    from codex_transfer import backup, restore, selftest
+    validator = importlib.import_module('codex_transfer.validate')
+    if args.action == 'build':
+        source = root / 'source'
+        codex, project = selftest._write_source(source)
+        roots = [project]
+        if args.profile == 'small':
+            for i in range(1, 40):
+                other = source / 'Documents' / f'P{i}'
+                other.mkdir(parents=True)
+                roots.append(other)
+        count, size = (5000, 1024) if args.profile == 'small' else (8, 16*1024**2)
+        data = bytes(range(256)) * (size // 256)
+        for i in range(count):
+            file = roots[i % len(roots)] / 'payload' / f'{i}.bin'
+            file.parent.mkdir(exist_ok=True)
+            file.write_bytes(data)
+        config = root / 'config.json'
+        save(config, dict(configVersion=1, includeAttachments=True,
+            projects=[dict(path=str(p), required=True) for p in roots[1:]],
+            additionalPortablePaths=[], excludeDirectoryNames=[],
+            projectRegistryPath=str(root/'registry.json'),
+            lineageStatePath=str(root/'lineage.json'), deviceStatePath=str(root/'device.json')))
+        package = backup.build_backup(argparse.Namespace(config=str(config),
+            destination=str(root/'packages'), source_profile=str(source),
+            source_codex_home=str(codex), allow_running_test=True))
+        save(root/'package.json', dict(path=str(package), files=count, bytes=count*size))
+        return
+    target = root / args.tag / 'target'
+    selftest._write_target(target, 'SYNTHETIC')
+    package = Path(json.loads((root/'package.json').read_text())['path'])
+    probes = 0
+    phases = {}
+    original = restore._ensure_restore_space
+    def probe(*values, **kwargs):
+        nonlocal probes
+        probes += 1
+        return original(*values, **kwargs)
+    from contextlib import ExitStack
+    with ExitStack() as stack:
+        stack.enter_context(patch.object(restore, '_ensure_restore_space', probe))
+        for name in ('_restore_projects', '_restore_sessions', '_restore_portable_profile', 'verify_restored'):
+            function = getattr(restore, name)
+            def timed(*values, _function=function, _name=name, **kwargs):
+                started = time.perf_counter()
+                try:
+                    return _function(*values, **kwargs)
+                finally:
+                    phases[_name] = phases.get(_name, 0) + time.perf_counter() - started
+            stack.enter_context(patch.object(restore, name, timed))
+        started = time.perf_counter()
+        prepared = restore.prepare_restore(package, target, allow_running_test=True)
+        prepare_seconds = time.perf_counter() - started
+        result = restore.restore_backup(package, target, Path(prepared['safetyRoot']))
+        elapsed = time.perf_counter() - started
+    save(root/(args.tag+'.json'), dict(variant=args.variant, seconds=elapsed,
+        prepare_seconds=prepare_seconds, restore_seconds=elapsed-prepare_seconds,
+        phases=phases, space_probes=probes, valid=result['verification']['valid'],
+        verification=result['verification']['checks']))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--baseline')
+    parser.add_argument('--candidate')
+    parser.add_argument('--root', required=True)
+    parser.add_argument('--action', choices=['build', 'restore'])
+    parser.add_argument('--source')
+    parser.add_argument('--profile')
+    parser.add_argument('--tag', default='build')
+    parser.add_argument('--variant')
+    args = parser.parse_args()
+    if args.action:
+        return worker(args)
+    root = Path(args.root).resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    report = dict(passed=False, order=['baseline','candidate','candidate','baseline'],
+        limitations='Synthetic Windows fixtures. ABBA order mitigates but does not remove cache bias. '
+        'Preparation includes full source validation. No extrapolation to 88 GiB or 5 million files. '
+        'No reviewed-plan interaction in timing cases; official regression covers conflict plans.', profiles={})
+    for profile in ('small', 'large'):
+        fixture = root / profile
+        fixture.mkdir()
+        save(fixture/'synthetic-owner.json', {'synthetic': True})
+        def invoke(action, source, tag='build', variant='baseline'):
+            command = [sys.executable, str(Path(__file__).resolve()), '--action', action,
+                '--root', str(fixture), '--source', source, '--profile', profile,
+                '--tag', tag, '--variant', variant]
+            with (fixture/(tag+'.log')).open('w', encoding='utf-8') as log:
+                subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, check=True, timeout=900)
+        invoke('build', args.baseline)
+        samples = []
+        for i, variant in enumerate(report['order']):
+            tag = f't{i}'
+            invoke('restore', getattr(args, variant), tag, variant)
+            samples.append(json.loads((fixture/(tag+'.json')).read_text()))
+        medians = {v: statistics.median(s['seconds'] for s in samples if s['variant']==v)
+                   for v in ('baseline', 'candidate')}
+        report['profiles'][profile] = dict(samples=samples, median_seconds=medians,
+            improvement_percent=(1-medians['candidate']/medians['baseline'])*100)
+        save(root/'comparison.json', report)
+    report['passed'] = all(s['valid'] for p in report['profiles'].values() for s in p['samples'])
+    save(root/'comparison.json', report)
+    print(json.dumps(report, indent=2))
+    if not report['passed']:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
