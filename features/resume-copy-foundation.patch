+++ b/src/codex_transfer/recovery_selftest.py
@@ -0,0 +1,57 @@
+"""Packaged recovery smoke test on newly-created synthetic data only."""
+import argparse
+import json
+import os
+from pathlib import Path
+import threading
+import traceback
+from unittest.mock import patch
+
+from . import backup, restore, restore_operation, selftest
+
+
+def run(root):
+    root = Path(root).resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    result = {'passed': False}
+    try:
+        environment = {name: str(root / name) for name in ('LOCALAPPDATA', 'APPDATA')}
+        for path in environment.values():
+            Path(path).mkdir()
+        with patch.dict(os.environ, environment):
+            source = root / 'source'
+            codex, project = selftest._write_source(source)
+            for number in range(100):
+                (project / f'synthetic-{number}.bin').write_bytes(b'fixture' * 128)
+            config = root / 'config.json'
+            config.write_text(json.dumps(dict(
+                configVersion=1, includeAttachments=True, projects=[], additionalPortablePaths=[],
+                excludeDirectoryNames=[], projectRegistryPath=str(root/'registry.json'),
+                lineageStatePath=str(root/'lineage.json'), deviceStatePath=str(root/'device.json'))))
+            package = backup.build_backup(argparse.Namespace(
+                config=str(config), destination=str(root/'packages'), source_profile=str(source),
+                source_codex_home=str(codex), allow_running_test=True))
+            target = root / 'target'
+            selftest._write_target(target, 'BEFORE')
+            prepared = restore.prepare_restore(package, target, allow_running_test=True)
+            document = restore_operation.create_document(prepared['safetyRoot'], package, target)
+            event = threading.Event()
+            def progress(value):
+                if value['phase'] == 'restore sessions':
+                    event.set()
+            paused = restore_operation.resume_from_document(document, event, progress)
+            assert paused['status'] == 'paused'
+            with patch.object(restore, 'copy_staging_tree', side_effect=AssertionError('project recopied')):
+                completed = restore_operation.resume_from_document(document)
+            assert completed['status'] == 'complete'
+            assert completed['verification']['valid']
+            assert 'recoveryRetention' in completed
+            assert (Path(prepared['safetyRoot'])/'shareable-operation-summary.json').is_file()
+            assert (target/'Documents/Codex Restore Reports/MIGRATION-PATHS.md').is_file()
+            result = {'passed': True, 'pausedAndReopened': True,
+                      'completedProjectsNotRecopied': True, 'finalVerification': True,
+                      'reportsAndRetention': True, 'migrationGuide': True}
+    except Exception:
+        result['error'] = traceback.format_exc()
+    backup.write_json(root/'recovery-self-test-result.json', result)
+    return result
