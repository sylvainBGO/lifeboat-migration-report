+        self.pause_button.pack(side='left', padx=8)
+        self.resume_button = ttk.Button(parent, text='Load resume plan', command=self._load_resume)
+        self.resume_button.pack(side='left', padx=8)
+        self.defender_button = ttk.Button(parent, text='Defender…', command=self._defender_dialog)
+        self.defender_button.pack(side='left', padx=8)
+        self.phase_progress = ttk.Progressbar(self.status_frame, maximum=100)
+        self.phase_progress.grid(row=7, column=0, columnspan=5, sticky='ew', pady=(10, 4))
+        self.phase_description = tk.Label(self.status_frame, text='Stage progress',
+                                          bg=self.CARD, anchor='w', width=80)
+        self.phase_description.grid(row=8, column=0, columnspan=5, sticky='ew')
+        self.status_label.configure(width=60, anchor='w')
+        self.status_label.grid_configure(sticky='ew')
+        for label in (self.elapsed_label, self.remaining_label, self.throughput_label):
+            label.configure(width=22, anchor='w')
+        for column in range(5):
+            self.status_frame.columnconfigure(column, weight=1, uniform='restore-stages')
+        self.after(3_600_000, self._check_defender_hourly)
