+            self.defender_prompt.lift()
+            return
+        window = self.defender_prompt = tk.Toplevel(self)
+        window.title('Microsoft Defender')
+        ttk.Label(window, wraplength=480, padding=16,
+                  text='Temporarily disable real-time protection? Windows will request administrator approval. '
+                       'Lifeboat continues working while you decide. Reactivate protection manually when finished. '
+                       'If Windows policy blocks the change, use Windows Security or contact your administrator.').pack()
+        def disable():
+            window.destroy()
+            self.defender_requested = True
+            def work():
+                try:
+                    self.messages.put(('defender_result', defender_control.request_disable()))
+                except Exception as exc:
+                    self.messages.put(('defender_result', {'available': False, 'error': str(exc)}))
+            threading.Thread(target=work, daemon=True).start()
+        ttk.Button(window, text='Request disable (Windows UAC)', command=disable).pack(pady=6)
+        ttk.Button(window, text='Continue without changing Defender', command=window.destroy).pack(pady=6)
+        # Deliberately no grab_set / wait_window: this dialog is nonmodal.
+
+    def _check_defender_hourly(self):
+        if self.busy and self.defender_requested:
+            def check():
+                try:
+                    self.messages.put(('defender_hourly', defender_control.status()))
+                except Exception as exc:
+                    self.messages.put(('log', 'Defender status unavailable: ' + str(exc)))
+            threading.Thread(target=check, daemon=True).start()
+        self.after(3_600_000, self._check_defender_hourly)
+
+    def _recovery_message(self, kind, value):
+        if kind == 'restore_progress':
+            self._structured_progress(value)
+        elif kind == 'resume_document':
+            self.resume_document = Path(value)
+            self.pause_button.configure(state='normal')
+            self._append_log('Resume document: ' + str(value))
+        elif kind == 'defender_hourly':
+            if value.get('RealTimeProtectionEnabled') is True:
+                self._append_log('Windows reactivated real-time protection.')
