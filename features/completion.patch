+def _check_central_directory(handle):
+    """Bound ZIP central-directory allocation before ZipFile reads it (ZIP64 too)."""
+    handle.seek(0, os.SEEK_END)
+    length = handle.tell()
+    if length < 22:
+        raise ArchiveError("Truncated archive block")
+    handle.seek(length - 22)
+    end = handle.read(22)
+    sig, disk, cd_disk, disk_entries, entries, cd_size, cd_offset, comment = struct.unpack("<4s4H2LH", end)
+    if sig != b"PK\x05\x06" or comment or disk or cd_disk:
+        raise ArchiveError("Archive comments, split volumes and trailing data are not supported")
+    central_end = length - 22
+    if entries == 0xFFFF or cd_size == 0xFFFFFFFF or cd_offset == 0xFFFFFFFF:
+        if length < 98:
+            raise ArchiveError("Truncated ZIP64 archive")
+        handle.seek(length - 42)
+        locator, locator_disk, offset, disks = struct.unpack("<4sLQL", handle.read(20))
+        if locator != b"PK\x06\x07" or locator_disk or disks != 1 or offset > length - 98:
+            raise ArchiveError("Invalid ZIP64 locator")
+        handle.seek(offset)
+        record = struct.unpack("<4sQ2H2L4Q", handle.read(56))
+        if record[0] != b"PK\x06\x06" or record[1] != 44 or record[4] or record[5]:
+            raise ArchiveError("Unsupported ZIP64 end record")
+        disk_entries, entries, cd_size, cd_offset = record[6:10]
+        central_end = offset
+    if (entries < 1 or entries > MAX_BLOCK_ENTRIES + 1 or disk_entries != entries
+            or cd_size > (MAX_BLOCK_ENTRIES + 1) * 256
+            or cd_offset + cd_size != central_end):
+        raise ArchiveError("Archive central directory exceeds bounds or is inconsistent")
+    handle.seek(0)
+    if handle.read(4) != b"PK\x03\x04":
+        raise ArchiveError("Archive block has an unexpected prefix")
+    handle.seek(0)
+
+
+def _validated_entry(entry, number):
+    if not isinstance(entry, dict):
+        raise ArchiveError("Archive entry must be an object")
+    kind = entry.get("kind")
+    fields = {"path", "kind", "mode", "mtimeNs"}
+    if kind == "file":
+        fields |= {"size", "sha256", "member"}
+    elif kind != "directory":
+        raise ArchiveError("Archive entry is not a regular file or directory")
+    if set(entry) != fields:
+        raise ArchiveError("Archive entry has missing or unsupported metadata")
+    safe_relative(entry["path"], allow_root=kind == "directory")
+    _integer(entry["mode"], "permission mode", 0, 0o777)
+    _integer(entry["mtimeNs"], "mtime_ns", -(1 << 63))
+    if kind == "file":
+        _integer(entry["size"], "file size")
+        if not isinstance(entry["sha256"], str) or not _DIGEST.fullmatch(entry["sha256"]):
+            raise ArchiveError("Invalid archive member SHA-256")
+        if entry["member"] != f"files/{number:08d}":
+            raise ArchiveError("Invalid archive object identifier")
+    return entry
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ArchiveError(f"Duplicate archive metadata key: {key}")
+        result[key] = value
+    return result
+
+
+@contextmanager
+def _open_block(root, relative, expected=None, check=None):
+    path = _physical_path(root, relative)
+    with path.open("rb") as handle:
+        if expected is not None:
+            if relative not in expected:
+                raise ArchiveError(f"Archive block is absent from the SHA-256 manifest: {relative}")
+            size, digest = expected[relative]
+            if os.fstat(handle.fileno()).st_size != size:
+                raise ArchiveError(f"Archive block size differs: {relative}")
+            actual = hashlib.sha256()
+            for chunk in iter(lambda: handle.read(CHUNK_BYTES), b""):
+                if check:
+                    check()
+                actual.update(chunk)
+            if actual.hexdigest() != digest:
+                raise ArchiveError(f"Archive block SHA-256 differs: {relative}")
+        _check_central_directory(handle)
+        try:
+            with zipfile.ZipFile(handle) as archive:
+                infos = archive.infolist()
+                if len({info.filename for info in infos}) != len(infos):
+                    raise ArchiveError("Duplicate ZIP member")
+                for info in infos:
+                    file_type = stat.S_IFMT(info.external_attr >> 16)
+                    if (info.flag_bits & ~0x808 or info.is_dir()
+                            or info.compress_type not in {zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED}
+                            or file_type not in {0, stat.S_IFREG}):
+                        raise ArchiveError("Encrypted, special or unsupported ZIP member")
+                index_info = archive.getinfo(INDEX_NAME)
+                if index_info.file_size > MAX_INDEX_BYTES:
+                    raise ArchiveError("Archive index exceeds its size limit")
+                with archive.open(index_info) as stream:
+                    raw = stream.read(MAX_INDEX_BYTES + 1)
+                if len(raw) != index_info.file_size or len(raw) > MAX_INDEX_BYTES:
+                    raise ArchiveError("Archive index length differs")
+                index = json.loads(raw, object_pairs_hook=_unique_object)
+                if (not isinstance(index, dict) or set(index) != {"archiveVersion", "entries"}
+                        or type(index["archiveVersion"]) is not int or index["archiveVersion"] != 1
+                        or not isinstance(index["entries"], list)
+                        or not 1 <= len(index["entries"]) <= MAX_BLOCK_ENTRIES):
+                    raise ArchiveError("Invalid project archive index")
+                entries = [_validated_entry(entry, number) for number, entry in enumerate(index["entries"])]
+                files = [entry for entry in entries if entry["kind"] == "file"]
+                if len(files) > 1 and sum(entry["size"] for entry in files) > MAX_BLOCK_BYTES:
+                    raise ArchiveError("Archive block exceeds its uncompressed byte limit")
+                expected_members = {INDEX_NAME}
+                for entry in entries:
+                    if entry["kind"] == "file":
+                        member = archive.getinfo(entry["member"])
+                        if member.file_size != entry["size"]:
+                            raise ArchiveError("ZIP size differs from project metadata")
+                        expected_members.add(entry["member"])
+                if expected_members != {info.filename for info in infos}:
+                    raise ArchiveError("ZIP contains undeclared or missing objects")
+                yield archive, entries
+        except (zipfile.BadZipFile, KeyError, json.JSONDecodeError, UnicodeError, EOFError, zlib.error) as exc:
+            raise ArchiveError(f"Invalid project archive block {relative}: {exc}") from exc
+
+
+def _member_chunks(archive, entry):
+    remaining = entry["size"]
+    digest = hashlib.sha256()
+    with archive.open(entry["member"]) as handle:
+        while remaining:
+            chunk = handle.read(min(CHUNK_BYTES, remaining))
+            if not chunk:
+                raise ArchiveError("Truncated archived project file")
+            digest.update(chunk)
+            remaining -= len(chunk)
+            yield chunk
+        if handle.read(1):
+            raise ArchiveError("Archived project file exceeds its declared size")
+    if digest.hexdigest() != entry["sha256"]:
+        raise ArchiveError(f"Archived project file SHA-256 differs: {entry['path']}")
+
+
+def iter_project_entries(package_root, project, expected=None, verify_hashes=False, check=None):
+    """Yield bounded block indexes, rejecting cross-block path collisions."""
+    count = size = 0
+    with _PathRegistry() as names:
+        for relative in block_paths(project):
+            with _open_block(package_root, relative, expected, check) as (archive, entries):
+                for entry in entries:
+                    if check:
+                        check()
+                    names.add(entry)
+                    if entry["kind"] == "file":
+                        count += 1
+                        size += entry["size"]
+                        if verify_hashes:
+                            for _chunk in _member_chunks(archive, entry):
+                                pass
+                    yield entry
+    if count != project.get("fileCount") or size != project.get("totalBytes"):
+        raise ArchiveError("Archived project counts differ from projects.json")
+
+
+def logical_rows(package_root, projects):
+    for project in projects:
+        if not is_archived(project):
+            continue
+        prefix = _prefix(project)
+        for entry in iter_project_entries(package_root, project):
+            if entry["kind"] == "file":
+                yield {"relative_path": prefix + "/" + entry["path"],
+                       "size": entry["size"], "sha256": entry["sha256"]}
+
+
+def inspect_package(package_root, package, projects, hash_rows, verify_hashes=True, progress=None):
+    """Validate virtual project files; return membership for the normal validator."""
+    archived = [item for item in projects if isinstance(item, dict) and is_archived(item)]
+    if package.get("formatVersion") != FORMAT_VERSION:
+        if archived or package.get("projectStorage") not in (None, "files"):
+            raise ArchiveError("Archived project storage requires package format 2.5")
+        return {"files": set(), "projects": {}, "hashesChecked": 0, "bytes": 0}
+    if package.get("projectStorage") != STORAGE or len(archived) != len(projects):
+        raise ArchiveError("Format 2.5 requires archive-blocks-v1 for every project")
+    result = {"files": set(), "projects": {}, "hashesChecked": 0, "bytes": 0}
+    physical_blocks = set()
+    for project in archived:
+        prefix = _prefix(project)
+        if prefix in result["projects"] or (Path(package_root) / prefix).exists():
+            raise ArchiveError("Archived project root is duplicated or also exists as physical files")
+        physical_blocks.update(block_paths(project))
+        count = size = 0
+        for entry in iter_project_entries(package_root, project, None, verify_hashes):
+            if entry["kind"] != "file":
+                continue
+            logical = prefix + "/" + entry["path"]
+            if hash_rows.get(logical) != (entry["size"], entry["sha256"]):
+                raise ArchiveError(f"Logical project hash differs from archive metadata: {logical}")
+            result["files"].add(logical)
+            count += 1
+            size += entry["size"]
+            if progress and count % 256 == 0:
+                progress(count, project["fileCount"], "Validating archived project files")
+        result["projects"][prefix] = {"files": count, "bytes": size}
+        result["hashesChecked"] += count if verify_hashes else 0
+        result["bytes"] += size
+    if any(path.startswith("project-archives/") and path not in physical_blocks for path in hash_rows):
+        raise ArchiveError("Manifest contains an unreferenced project archive object")
+    if any(path not in hash_rows for path in physical_blocks):
+        raise ArchiveError("A project archive block is missing from the SHA-256 manifest")
+    return result
+
+
+def _block_hashes(package_root, project, manifest_index=None):
+    required = set(block_paths(project))
+    if manifest_index is not None:
+        prefix = _block_prefix(_prefix(project))
+        result = {prefix + "/" + path: value for path, value in
+                  manifest_index.select({"backupRelativePath": prefix}).items()}
+        if set(result) != required:
+            raise ArchiveError("Archive block hashes differ from the indexed manifest")
+        return result
+    result = {}
+    with (Path(package_root) / "manifest/sha256.csv").open(encoding="utf-8", newline="") as handle:
+        for row in csv.DictReader(handle):
+            if row["relative_path"] in required:
+                if row["relative_path"] in result:
+                    raise ArchiveError("Duplicate archive block hash")
+                digest = row["sha256"]
+                if not _DIGEST.fullmatch(digest):
+                    raise ArchiveError("Invalid archive block hash")
+                result[row["relative_path"]] = (int(row["size"]), digest)
+    if set(result) != required:
+        raise ArchiveError("Missing archive block hashes")
+    return result
+
+
+def _target_path(root, relative, directory=False):
+    safe_relative(relative, allow_root=directory)
+    root = Path(root)
+    if root.exists() or root.is_symlink():
+        _regular_info(root, directory=True)
+    else:
+        root.mkdir(parents=True)
+    current = root
+    parts = relative.split("/") if relative else []
+    for number, part in enumerate(parts):
+        current = current / part
+        is_directory = directory or number < len(parts) - 1
+        if current.exists() or current.is_symlink():
+            _regular_info(current, directory=is_directory)
+        elif is_directory:
+            current.mkdir()
+    return current
+
+
+def _set_metadata(path, entry):
+    _regular_info(path, directory=entry["kind"] == "directory")
+    chmod_options = {"follow_symlinks": False} if os.chmod in os.supports_follow_symlinks else {}
+    os.chmod(path, entry["mode"], **chmod_options)
+    # atime is intentionally not promised: mandatory integrity reads can alter it.
+    current_atime = Path(path).stat().st_atime_ns
+    utime_options = {"follow_symlinks": False} if os.utime in os.supports_follow_symlinks else {}
+    os.utime(path, ns=(current_atime, entry["mtimeNs"]), **utime_options)
+
+
+def _remove_temporary(path):
+    if path.exists() or path.is_symlink():
+        _regular_info(path)
+        os.chmod(path, stat.S_IRUSR | stat.S_IWUSR)
+        path.unlink()
+
+
+def extract_project(package_root, project, destination, probe, checkpoint=None, on_progress=None,
+                    manifest_index=None):
+    """Stream verified objects directly into an exclusively owned staging tree."""
+    from .space_budget import CopySpaceBudget
+    prefix = _prefix(project)
+    destination = Path(destination)
+    expected = _block_hashes(package_root, project, manifest_index)
+    budget = CopySpaceBudget(probe)
+    count = size = 0
+    completed = False
+    check = checkpoint.check if checkpoint else None
+    try:
+        with _PathRegistry() as names:
+            for relative in block_paths(project):
+                if checkpoint:
+                    checkpoint.check()
+                with _open_block(package_root, relative, expected, check) as (archive, entries):
+                    for entry in entries:
+                        names.add(entry)
+                        if checkpoint:
+                            checkpoint.check()
+                        if entry["kind"] == "directory":
+                            budget(None, destination / entry["path"], 0)
+                            _target_path(destination, entry["path"], directory=True)
+                            continue
+                        virtual_source = Path(package_root) / prefix / entry["path"]
+                        count += 1
+                        size += entry["size"]
+                        if checkpoint and checkpoint.done(virtual_source):
+                            if on_progress:
+                                on_progress(count, size)
+                            continue
+                        target = _target_path(destination, entry["path"])
+                        budget(virtual_source, target, entry["size"])
+                        temp = target.with_name(TEMP_PREFIX + hashlib.sha256(entry["path"].encode()).hexdigest()[:24] + ".tmp")
+                        _remove_temporary(temp)
+                        remaining = entry["size"]
+                        last_probe = time.monotonic()
+                        try:
+                            with temp.open("xb") as output:
+                                for chunk in _member_chunks(archive, entry):
+                                    if checkpoint:
+                                        checkpoint.check()
+                                    now = time.monotonic()
+                                    if now - last_probe >= 1:
+                                        probe(target, remaining, 1)
+                                        last_probe = now
+                                    output.write(chunk)
+                                    remaining -= len(chunk)
+                                output.flush()
+                                os.fsync(output.fileno())
+                            # Windows can finalize LastWriteTime when the last
+                            # content-writing handle closes. Apply the requested
+                            # timestamp only after that handle is closed.
+                            _set_metadata(temp, entry)
+                            if target.exists():
+                                _regular_info(target)
+                                os.chmod(target, stat.S_IRUSR | stat.S_IWUSR)
+                            os.replace(temp, target)
+                            if checkpoint:
+                                checkpoint.complete(virtual_source, entry["size"])
+                            if on_progress:
+                                on_progress(count, size)
+                        finally:
+                            _remove_temporary(temp)
+        if count != project["fileCount"] or size != project["totalBytes"]:
+            raise ArchiveError("Extracted project counts differ from the inventory")
+        # Children are written after parents. Restore directory mtimes/modes only
+        # after the complete tree exists, deepest first, without storing it in RAM.
+        for relative in reversed(block_paths(project)):
+            with _open_block(package_root, relative, expected, check) as (_archive, entries):
+                for entry in reversed(entries):
+                    if check:
+                        check()
+                    if entry["kind"] == "directory":
+                        _set_metadata(_target_path(destination, entry["path"], directory=True), entry)
+        completed = True
+        return count, size
+    finally:
+        if checkpoint:
+            if completed:
+                checkpoint.flush()
+            else:
+                # Preserve the original error/pause even if the ledger volume
+                # also fills. Uncommitted entries will safely be copied again.
+                with suppress(OSError, sqlite3.Error):
+                    checkpoint.flush()
+
+
+def verify_metadata(package_root, project, destination, manifest_index=None, check=None, hash_rows=None):
+    """Verify explicit directories and file metadata, in addition to final hashes."""
+    destination = Path(destination)
+    expected = hash_rows if hash_rows is not None else _block_hashes(package_root, project, manifest_index)
+    expected_directories = 0
+    expected_files = 0
+    for entry in iter_project_entries(package_root, project, expected, check=check):
+        path = destination / entry["path"]
+        info = _regular_info(path, directory=entry["kind"] == "directory")
+        # Windows exposes read-only versus writable bits; POSIX exposes all rwx.
+        mode_mask = 0o222 if os.name == "nt" else 0o777
+        if ((stat.S_IMODE(info.st_mode) & mode_mask) != (entry["mode"] & mode_mask)
+                or info.st_mtime_ns != entry["mtimeNs"]):
+            raise ArchiveError(f"Restored archive metadata differs: {entry['path'] or '(project root)'}")
+        expected_directories += int(entry["kind"] == "directory")
+        expected_files += int(entry["kind"] == "file")
+    actual_directories = actual_files = 0
+    stack = [destination]
+    while stack:
+        if check:
+            check()
+        directory = stack.pop()
+        _regular_info(directory, directory=True)
+        actual_directories += 1
+        with os.scandir(directory) as scan:
+            for entry in scan:
+                info = Path(entry.path).lstat()
+                if stat.S_ISDIR(info.st_mode) and not _reparse(info):
+                    stack.append(Path(entry.path))
+                else:
+                    _regular_info(entry.path)
+                    actual_files += 1
+    if (actual_directories, actual_files) != (expected_directories, expected_files):
+        raise ArchiveError("Restored archive directory/file set differs")
