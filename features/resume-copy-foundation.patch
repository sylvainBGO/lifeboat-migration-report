+from tkinter import ttk, filedialog, messagebox
+
+from . import defender_control, restore_operation, backup
+
+PHASES = ['index backup manifest', 'restore projects', 'apply destination project decisions',
+          'build restored database', 'reset paginated history projection',
+          'restore portable profile', 'restore sessions', 'restore preserved conversations',
+          'restore attachments', 'restore global state', 'rebuild session index', 'verify restored', 'finish']
+
+
+class RecoveryUI:
+    def _init_recovery_ui(self):
+        self.pause_event = threading.Event()
+        self.resume_document = None
+        self.operation_paused = False
+        self.structured_restore = False
+        self.defender_prompt = None
+        self.defender_requested = False
+        self.defender_last_state = None
+        self.last_metric = None
+        self.close_after_pause = False
+        self.protocol('WM_DELETE_WINDOW', self._close_recovery_window)
+        parent = self.restore_button.master
+        self.pause_button = ttk.Button(parent, text='Pause', command=self._request_pause, state='disabled')
+        self.pause_button.pack(side='left', padx=8)
+        self.resume_button = ttk.Button(parent, text='Load resume plan', command=self._load_resume)
+        self.resume_button.pack(side='left', padx=8)
+        self.defender_button = ttk.Button(parent, text='Defender…', command=self._defender_dialog)
+        self.defender_button.pack(side='left', padx=8)
+        self.phase_progress = ttk.Progressbar(self.status_frame, maximum=100)
+        self.phase_progress.grid(row=7, column=0, columnspan=5, sticky='ew', pady=(10, 4))
+        self.phase_description = tk.Label(self.status_frame, text='Stage progress',
+                                          bg=self.CARD, anchor='w', width=80)
+        self.phase_description.grid(row=8, column=0, columnspan=5, sticky='ew')
+        self.status_label.configure(width=60, anchor='w')
+        self.status_label.grid_configure(sticky='ew')
+        for label in (self.elapsed_label, self.remaining_label, self.throughput_label):
+            label.configure(width=22, anchor='w')
+        for column in range(5):
+            self.status_frame.columnconfigure(column, weight=1, uniform='restore-stages')
+        self.after(3_600_000, self._check_defender_hourly)
+
+    def _close_recovery_window(self):
+        if self.busy:
+            self.close_after_pause = True
+            self._request_pause()
+        else:
+            self.destroy()
+
+    def _request_pause(self):
+        self.pause_event.set()
+        self.pause_button.configure(state='disabled')
+        self.status_label.configure(text='Pause requested — finishing admitted writes…')
+
+    def _load_resume(self):
+        if self.busy:
+            return
+        selected = filedialog.askopenfilename(parent=self, title='Load resume plan',
+                                               filetypes=[('Lifeboat resume plan', '*.json')])
+        if not selected:
+            return
+        try:
+            state = backup.read_json(Path(selected).parent / 'restore-journal.json')
+            if state.get('status') == 'prepared' and not messagebox.askyesno(
+                    'Start prepared restoration?',
+                    'This plan has not started restoring yet. Start replacing local data using the saved safety copy?',
+                    parent=self):
+                return
+        except Exception as exc:
+            messagebox.showerror('Resume plan', str(exc), parent=self)
+            return
+        self.resume_document = Path(selected)
+        self.pause_event = threading.Event()
+        self.operation_paused = False
+        self._run(lambda: restore_operation.resume_from_document(
+            self.resume_document, self.pause_event, self._structured_callback,
+            self._operation_log_callback), self._resume_done, 'restore')
+        self.pause_button.configure(state='normal')
+
+    def _structured_callback(self, value):
+        self.messages.put(('restore_progress', value))
+
+    def _structured_progress(self, value):
+        self.structured_restore = True
+        phase = value['phase']
+        current, total = value['current'], value['total']
+        index = PHASES.index(phase) if phase in PHASES else 0
+        # Workflow progress counts phases; it is explicitly not a time forecast.
+        fraction = min(current/total, 1) if total else 0
+        finished = value['message'] == phase + ' complete'
+        percent = 15 + 80 * (index + int(finished)) / len(PHASES)
+        self.operation_progress = max(self.operation_progress, percent)
+        self.progress.configure(value=self.operation_progress)
+        self.progress_percent.configure(text=f'{self.operation_progress:.0f}%')
+        self.progress_measure.configure(text=f'Workflow steps: {index + int(finished)}/{len(PHASES)} — not elapsed-time %')
+        self.operation_title.configure(text='Restoring backup')
+        self.status_label.configure(text=value['message'])
+        self.last_progress_message = value['message']
+        self.phase_progress.stop()
+        if total:
+            self.phase_progress.configure(mode='determinate', maximum=100, value=100*fraction)
+            measure = (f'{current/1024**3:.2f} / {total/1024**3:.2f} GiB' if value.get('unit') == 'bytes'
+                       else f'{current:,} / {total:,} {value.get("unit", "items")}')
+            self.phase_description.configure(text=f'{phase}: {measure} ({fraction:.1%})')
+        else:
+            self.phase_progress.configure(mode='indeterminate')
+            self.phase_progress.start(30)
+            self.phase_description.configure(text=f'{phase}: {current:,} processed — total not yet known')
+        # Phase metrics are not whole-restore estimates.
+        now = time.monotonic()
+        previous = self.last_metric
+        rate = ((current-previous[1]) / max(now-previous[2], .001)
+                if previous and previous[0] == phase and current >= previous[1] else 0)
+        self.last_metric = (phase, current, now)
+        remaining = (total-current)/rate if total and rate else None
+        self.remaining_label.configure(text=f'Stage remaining: {self._format_duration(remaining)}')
+        rate_text = f'{rate/1024**2:,.1f} MiB/s' if value.get('unit') == 'bytes' else f'{rate:,.1f} {value.get("unit", "items")}/s'
+        self.throughput_label.configure(text=rate_text if rate else 'Stage rate: —')
+        stage = (0 if phase == 'index backup manifest' else
+                 1 if phase in {'restore projects', 'apply destination project decisions'} else
+                 3 if phase == 'verify restored' else 4 if phase == 'finish' else 2)
+        # Render explicit completed phases, not completion inferred from old weights.
+        for i, (dot, label) in enumerate(zip(self.stage_dots, self.stage_labels)):
+            dot.configure(text='✓' if i < stage else str(i+1),
+                          bg=self.SUCCESS if i < stage else '#FFF0D6' if i == stage else '#EDF1F5')
+
+    def _resume_done(self, result):
+        if result.get('status') == 'paused':
+            self.operation_paused = True
+            self.header_status.configure(text='● Paused', bg='#FFF0D6', fg='#A85B00')
+            self.operation_title.configure(text='Restoration paused')
+            self.status_label.configure(text=result.get('pauseReason', 'Paused'))
+            self._append_log(f'Resume document: {self.resume_document}')
+            messagebox.showinfo('Paused', 'Completed work is saved. Reload this document to continue:\n'
+                                + str(self.resume_document), parent=self)
+        else:
+            warnings = [str(result[key]) for key in ('reportWarning', 'recoveryRetentionError') if key in result]
+            messagebox.showinfo('Restore complete', 'Final verification passed.\n'
+                                + ('Warnings: ' + '\n'.join(warnings) + '\n' if warnings else 'Reports and recovery retention completed.\n')
+                                + 'If you disabled Defender, reactivate real-time protection now.', parent=self)
+
+    def _defender_dialog(self):
+        if self.defender_prompt is not None and self.defender_prompt.winfo_exists():
+            self.defender_prompt.lift()
+            return
+        window = self.defender_prompt = tk.Toplevel(self)
+        window.title('Microsoft Defender')
+        ttk.Label(window, wraplength=480, padding=16,
+                  text='Temporarily disable real-time protection? Windows will request administrator approval. '
+                       'Lifeboat continues working while you decide. Reactivate protection manually when finished. '
+                       'If Windows policy blocks the change, use Windows Security or contact your administrator.').pack()
+        def disable():
+            window.destroy()
+            self.defender_requested = True
+            def work():
+                try:
+                    self.messages.put(('defender_result', defender_control.request_disable()))
+                except Exception as exc:
+                    self.messages.put(('defender_result', {'available': False, 'error': str(exc)}))
+            threading.Thread(target=work, daemon=True).start()
+        ttk.Button(window, text='Request disable (Windows UAC)', command=disable).pack(pady=6)
+        ttk.Button(window, text='Continue without changing Defender', command=window.destroy).pack(pady=6)
+        # Deliberately no grab_set / wait_window: this dialog is nonmodal.
+
+    def _check_defender_hourly(self):
+        if self.busy:
+            self._queue_defender_check()
+        self.after(3_600_000, self._check_defender_hourly)
+
+    def _queue_defender_check(self):
+        if self.busy:
+            def check():
+                try:
+                    self.messages.put(('defender_hourly', defender_control.status()))
+                except Exception as exc:
+                    self.messages.put(('log', 'Defender status unavailable: ' + str(exc)))
+            threading.Thread(target=check, daemon=True).start()
+
+    def _recovery_message(self, kind, value):
+        if kind == 'restore_progress':
+            self._structured_progress(value)
+        elif kind == 'resume_document':
+            self.resume_document = Path(value)
+            self.pause_button.configure(state='normal')
+            self._append_log('Resume document: ' + str(value))
+        elif kind == 'defender_hourly':
+            state = value.get('RealTimeProtectionEnabled')
+            if self.defender_last_state is False and state is True:
+                self._append_log('Windows reactivated real-time protection.')
+                self._defender_dialog()
+            if isinstance(state, bool):
+                self.defender_last_state = state
+        elif kind == 'defender_result':
+            self.defender_last_state = value.get('RealTimeProtectionEnabled')
+            text = ('Real-time protection is disabled. Reactivate it manually when finished.'
+                    if value.get('RealTimeProtectionEnabled') is False else
+                    'Real-time protection remains enabled or its state is unavailable. '
+                    'Windows policy, tamper protection or cancelled elevation may block the change.')
+            self._append_log(text)
+            messagebox.showinfo('Defender status', text, parent=self)
+        else:
+            return False
+        return True
