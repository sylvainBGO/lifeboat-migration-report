+    def _structured_progress(self, value):
+        self.structured_restore = True
+        phase = value['phase']
+        current, total = value['current'], value['total']
+        index = PHASES.index(phase) if phase in PHASES else 0
+        # Workflow progress counts phases; it is explicitly not a time forecast.
+        fraction = min(current/total, 1) if total else 0
+        finished = value['message'] == phase + ' complete'
+        percent = 15 + 80 * (index + int(finished)) / len(PHASES)
+        self.operation_progress = max(self.operation_progress, percent)
+        self.progress.configure(value=self.operation_progress)
+        self.progress_percent.configure(text=f'{self.operation_progress:.0f}%')
+        self.progress_measure.configure(text=f'Workflow steps: {index + int(finished)}/{len(PHASES)} — not elapsed-time %')
+        self.operation_title.configure(text='Restoring backup')
+        self.status_label.configure(text=value['message'])
+        self.last_progress_message = value['message']
+        self.phase_progress.stop()
+        if total:
+            self.phase_progress.configure(mode='determinate', maximum=100, value=100*fraction)
+            self.phase_description.configure(text=f'{phase}: {current:,} / {total:,} ({fraction:.1%})')
+        else:
+            self.phase_progress.configure(mode='indeterminate')
+            self.phase_progress.start(30)
+            self.phase_description.configure(text=f'{phase}: {current:,} processed — total not yet known')
+        # Phase metrics are not whole-restore estimates.
+        elapsed = value.get('phaseSeconds', 0)
+        rate = current / elapsed if elapsed > 1 and current else 0
+        remaining = (total-current)/rate if total and rate else None
+        self.remaining_label.configure(text=f'Stage remaining: {self._format_duration(remaining)}')
+        self.throughput_label.configure(text=f'Stage units/s: {rate:,.1f}' if rate else 'Stage units/s: —')
+        stage = 1 if index <= 1 else 2 if index <= 9 else 3
