@@ -0,0 +1,101 @@
+"""Actual Windows restore with durable operation checkpoints."""
+import os
+from pathlib import Path
+import threading
+import unittest
+from unittest.mock import patch
+import test_windows_optimization as fixtures
+
+
+@unittest.skipUnless(os.name == 'nt', 'Actual Windows restore integration')
+class ResumeTests(unittest.TestCase):
+    setUp = fixtures.WindowsRestoreTests.setUp
+    target_snapshot = fixtures.WindowsRestoreTests.target_snapshot
+
+    def prepare(self):
+        from codex_transfer import restore_operation
+        prepared = self.restore.prepare_restore(self.package, self.target, allow_running_test=True)
+        self.safety = Path(prepared['safetyRoot'])
+        self.document = restore_operation.create_document(self.safety, self.package, self.target)
+        return restore_operation
+
+    def test_pause_at_each_phase_then_finish_with_standard_report(self):
+        operation = self.prepare()
+        waiting = ['restore projects', 'apply destination project decisions',
+                   'build restored database', 'reset paginated history projection',
+                   'restore portable profile', 'restore sessions',
+                   'restore preserved conversations', 'restore attachments',
+                   'restore global state', 'verify restored']
+        # Each invocation opens the persisted operation document afresh.
+        for expected in waiting:
+            event = threading.Event()
+            def progress(value):
+                if value['phase'] == expected and value['current'] == 0:
+                    event.set()
+            result = operation.resume_from_document(self.document, event, progress)
+            self.assertEqual(result['status'], 'paused', expected)
+        with patch.object(self.restore, 'copy_staging_tree', side_effect=AssertionError('project copied twice')), \
+             patch.object(self.restore, 'validate', side_effect=AssertionError('source preflight repeated')):
+            result = operation.resume_from_document(self.document)
+        self.assertEqual(result['status'], 'complete')
+        self.assertTrue(result['verification']['valid'])
+        self.assertIn('recoveryRetention', result)
+        reports = list((self.target/'Documents'/'Codex Restore Reports').glob('*.json'))
+        self.assertTrue(reports)
+
+    def test_pause_inside_sessions_preserves_already_rewritten_files(self):
+        operation = self.prepare()
+        event = threading.Event()
+        completed = []
+        original = self.restore._rewrite_copy.__wrapped__
+        def rewrite(source, target, translator):
+            result = original(source, target, translator)
+            if operation.CURRENT.get().phase == 'restore sessions':
+                completed.append(str(target))
+                event.set()
+            return result
+        rewrite.__name__ = '_rewrite_copy'
+        # Wrap the underlying implementation with the real file checkpoint.
+        with patch.object(self.restore, '_rewrite_copy', operation.file_task(rewrite)):
+            result = operation.resume_from_document(self.document, event)
+        self.assertEqual(result['status'], 'paused')
+        self.assertTrue(completed)
+        before = {path: Path(path).read_bytes() for path in completed}
+        # Same checkpoint key uses the production function name.
+        with patch.object(self.restore, '_remove_path', wraps=self.restore._remove_path) as remove:
+            result = operation.resume_from_document(self.document)
+            removed = {str(c.args[0]) for c in remove.call_args_list}
+            self.assertNotIn(str(self.target/'.codex/sessions'), removed)
+        self.assertEqual(result['status'], 'complete')
+        for path, content in before.items():
+            self.assertEqual(Path(path).read_bytes(), content)
+
+    def test_resume_after_unjournaled_project_activation(self):
+        operation = self.prepare()
+        move = self.restore._atomic_directory_move
+        class ProcessExit(BaseException):
+            pass
+        fired = False
+        def crash(source, target):
+            nonlocal fired
+            move(source, target)
+            if '.codex-lifeboat-stage-' in Path(source).name and not fired:
+                fired = True
+                raise ProcessExit()
+        with patch.object(self.restore, '_atomic_directory_move', crash):
+            with self.assertRaises(ProcessExit):
+                operation.resume_from_document(self.document)
+        with patch.object(self.restore, 'copy_staging_tree', side_effect=AssertionError('activated project recopied')):
+            result = operation.resume_from_document(self.document)
+        self.assertEqual(result['status'], 'complete')
+        self.assertTrue(result['verification']['valid'])
+
+    def test_low_space_pauses_without_rollback(self):
+        operation = self.prepare()
+        from codex_transfer.restore_checkpoint import RestorePaused
+        with patch.object(self.restore, '_ensure_restore_space', side_effect=RestorePaused('low space')), \
+             patch.object(self.restore, 'rollback_restore', side_effect=AssertionError('pause rolled back')):
+            result = operation.resume_from_document(self.document)
+        self.assertEqual(result['status'], 'paused')
+        result = operation.resume_from_document(self.document)
+        self.assertEqual(result['status'], 'complete')
