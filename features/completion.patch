+    def test_discovery_loads_plan_but_never_starts_restoration(self):
+        from codex_transfer.resume_discovery import ResumeCandidate
+        candidate = ResumeCandidate(Path('C:/recovery/resume-plan.json'), Path('C:/backup'),
+                                    Path.home(), 'paused', 1, True)
+        with patch.object(self.app, '_run', side_effect=AssertionError('auto-restore')):
+            self.app._recovery_message('resume_discovered', ([candidate], []))
+        self.assertEqual(self.app.resume_document, candidate.document)
+        self.assertEqual(str(self.app.resume_ready_button['state']), 'normal')
