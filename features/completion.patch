+                             ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+        if len(encoded) > MAX_INDEX_BYTES:
+            raise ArchiveError("Archive index exceeds its bounded size")
+        archive.writestr(INDEX_NAME, encoded, compress_type=zipfile.ZIP_STORED)
+        path = Path(archive.filename)
+        archive.close()
+        archive = None
