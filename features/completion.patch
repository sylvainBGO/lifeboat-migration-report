new file mode 100644
index 0000000..c569814
--- /dev/null
+++ b/src/codex_transfer/conversation_warmup.py
@@ -0,0 +1,564 @@
+"""Bounded, opt-in pre-reading of local Codex conversation files.
+
+This prepares *only* ordinary OS file-cache pages. It does not initialize Codex,
+hydrate its application cache, start a thread, acknowledge read state, or promise
+a faster opening. No conversation bytes, titles, IDs or paths leave this module.
+
+SQLite is queried on a short-lived private DB+WAL copy: even ``mode=ro`` can
+create WAL sidecars or change SHM read marks on the original database. Snapshot
+stability is checked, but does not establish an atomic view of a live application.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+import heapq
+import os
+from pathlib import Path
+import sqlite3
+import stat
+import tempfile
+import time
+from typing import Any, Callable, Iterator
+
+
+DEFAULT_TOTAL_BYTES = 256 * 1024 * 1024
+DEFAULT_FILE_BYTES = 16 * 1024 * 1024
+DEFAULT_INDEX_BYTES = 64 * 1024 * 1024
+DEFAULT_SECONDS = 60.0
+_CHUNK = 256 * 1024
+_MAX_THREADS = 50
+_MAX_SCAN_ENTRIES = 20000
+_MAX_SCAN_DEPTH = 8
+_REPARSE = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)
+
+
+class _Stop(Exception):
+    def __init__(self, reason: str):
+        self.reason = reason
+
+
+class _IndexUnavailable(Exception):
+    def __init__(self, reason: str):
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class _File:
+    path: Path
+    size: int
+    mtime_ns: int
+    device: int
+    inode: int
+
+
+class _Control:
+    def __init__(self, cancel: Any, seconds: float):
+        self.cancel = cancel
+        self.started = time.monotonic()
+        self.deadline = self.started + seconds
+
+    def reason(self) -> str | None:
+        if self.cancel is not None:
+            cancelled = (
+                self.cancel() if callable(self.cancel) else self.cancel.is_set()
+            )
+            if cancelled:
+                return "cancelled"
+        if time.monotonic() >= self.deadline:
+            return "time_budget"
+        return None
+
+    def check(self) -> None:
+        reason = self.reason()
+        if reason:
+            raise _Stop(reason)
+
+
+def _local_path(path: Path) -> bool:
+    text = str(path)
+    if text.startswith(("\\\\", "//")):
+        return False
+    if os.name == "nt":
+        import ctypes
+
+        # Reject mapped network drives as well as explicit UNC paths.
+        return ctypes.windll.kernel32.GetDriveTypeW(str(path.anchor)) in (2, 3, 6)
+    return True
+
+
+def validate_report_destination(codex_home: Path | str, report: Path | str) -> Path:
+    """Validate a new local report path without creating directories or files.
+
+    Resolve existing parent links before checking the source boundary. An
+    existing destination (including a dangling link) is never a valid report.
+    Call again immediately before writing if work occurred since validation;
+    the writer should also use exclusive creation to handle competing writers.
+    """
+    home = Path(codex_home).expanduser().absolute().resolve(strict=False)
+    original = Path(report).expanduser().absolute()
+    if not _local_path(original):
+        raise ValueError("The report destination must be local")
+    destination = original.resolve(strict=False)
+    if not _local_path(destination):
+        raise ValueError("The report destination must be local")
+    if destination == home or destination.is_relative_to(home):
+        raise ValueError("A warmup report must be outside the Codex directory")
+    for path in (original, destination):
+        try:
+            path.lstat()
+        except FileNotFoundError:
+            continue
+        except OSError:
+            raise ValueError("The report destination cannot be validated") from None
+        raise ValueError("The report destination already exists")
+    return destination
+
+
+def _linked(info: os.stat_result) -> bool:
+    return stat.S_ISLNK(info.st_mode) or bool(
+        getattr(info, "st_file_attributes", 0) & _REPARSE
+    )
+
+
+def _home_path(value: Path | str) -> Path:
+    path = Path(value).absolute()
+    if ".." in path.parts or not _local_path(path):
+        raise ValueError("A local Codex directory is required")
+    for part in reversed((path, *path.parents)):
+        info = part.lstat()
+        if _linked(info) or not stat.S_ISDIR(info.st_mode):
+            raise ValueError("A directory without symbolic links is required")
+    return path
+
+
+def _file(home: Path, path: Path, *, conversation: bool = False) -> _File:
+    """Admit regular files inside the selected home, without following links."""
+    home_info = home.lstat()
+    if _linked(home_info) or not stat.S_ISDIR(home_info.st_mode):
+        raise ValueError("Codex directory changed")
+    if not path.is_absolute():
+        path = home / path
+    relative = path.relative_to(home)
+    if not relative.parts or any(
+        part in (".", "..") or ":" in part for part in relative.parts
+    ):
+        raise ValueError("Invalid relative file")
+    if conversation:
+        if relative.parts[0] != "sessions" or not path.name.casefold().endswith(
+            (".jsonl", ".jsonl.zst")
+        ):
+            raise ValueError("Only active local rollout files are eligible")
+    current = home
+    for index, part in enumerate(relative.parts):
+        current /= part
+        info = current.lstat()
+        if _linked(info):
+            raise ValueError("Linked files are not eligible")
+        if index < len(relative.parts) - 1 and not stat.S_ISDIR(info.st_mode):
+            raise ValueError("Invalid parent directory")
+    if not stat.S_ISREG(info.st_mode) or info.st_nlink > 1:
+        raise ValueError("Only unlinked regular files are eligible")
+    return _File(path, info.st_size, info.st_mtime_ns, info.st_dev, info.st_ino)
+
+
+def _unchanged(info: os.stat_result, item: _File) -> bool:
+    return (
+        stat.S_ISREG(info.st_mode)
+        and not _linked(info)
+        and info.st_dev == item.device
+        and info.st_ino == item.inode
+        and info.st_size == item.size
+        and info.st_mtime_ns == item.mtime_ns
+    )
+
+
+@contextmanager
+def _reader(home: Path, item: _File) -> Iterator[Any]:
+    # Recheck the directory chain and the opened file, including replacement
+    # between discovery and open. O_NOFOLLOW also protects the final component.
+    if _file(home, item.path) != item:
+        raise ValueError("File changed before reading")
+    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(item.path, flags)
+    try:
+        if not _unchanged(os.fstat(descriptor), item) or _file(home, item.path) != item:
+            raise ValueError("File changed while opening")
+        with os.fdopen(descriptor, "rb", buffering=0) as handle:
+            descriptor = -1
+            yield handle
+    finally:
+        if descriptor >= 0:
+            os.close(descriptor)
+
+
+def _warn(result: dict[str, Any], code: str) -> None:
+    if code not in result["warnings"]:
+        result["warnings"].append(code)
+
+
+def _emit(
+    result: dict[str, Any], control: _Control, callback: Callable | None, phase: str
+) -> None:
+    if callback:
+        callback(
+            {
+                "phase": phase,
+                "selected": result["selected"],
+                "filesRead": result["filesRead"],
+                "skipped": result["skipped"],
+                "bytesRead": result["bytesRead"],
+                "metadataBytesRead": result["metadataBytesRead"],
+                "elapsedSeconds": round(time.monotonic() - control.started, 3),
+            }
+        )
+
+
+def _copy_index_file(
+    home: Path, item: _File, target: Path, control: _Control, result: dict[str, Any]
+) -> None:
+    with _reader(home, item) as source, target.open("xb") as output:
+        remaining = item.size
+        while remaining:
+            control.check()
+            chunk = source.read(min(_CHUNK, remaining))
+            if not chunk:
+                raise _IndexUnavailable("index_changed_during_snapshot")
+            output.write(chunk)
+            result["metadataBytesRead"] += len(chunk)
+            remaining -= len(chunk)
+        if not _unchanged(os.fstat(source.fileno()), item):
+            raise _IndexUnavailable("index_changed_during_snapshot")
+
+
+def _database_candidates(
+    home: Path,
+    limit: int,
+    max_index_bytes: int,
+    control: _Control,
+    result: dict[str, Any],
+) -> list[_File]:
+    database = home / "state_5.sqlite"
+    wal = home / "state_5.sqlite-wal"
+    journal = home / "state_5.sqlite-journal"
+    control.check()
+    try:
+        source = _file(home, database)
+        if journal.exists():
+            raise _IndexUnavailable("index_has_rollback_journal")
+        source_wal = _file(home, wal) if wal.exists() else None
+        items = [source] + ([source_wal] if source_wal else [])
+        if sum(item.size for item in items) > max_index_bytes:
+            raise _IndexUnavailable("index_byte_budget")
+        temp_root = _home_path(tempfile.gettempdir())
+        if not _local_path(temp_root):
+            raise _IndexUnavailable("temporary_directory_not_local")
+        # Only DB and WAL are copied. Auth files and the original SHM are never
+        # opened. SQLite may create its own SHM solely in this private directory.
+        with tempfile.TemporaryDirectory(
+            prefix="lifeboat-warmup-", dir=temp_root
+        ) as directory:
+            snapshot = Path(directory) / "state_5.sqlite"
+            for item in items:
+                _copy_index_file(
+                    home, item, Path(directory) / item.path.name, control, result
+                )
+            control.check()
+            if (
+                _file(home, database) != source
+                or wal.exists() != (source_wal is not None)
+                or (source_wal is not None and _file(home, wal) != source_wal)
+                or journal.exists()
+            ):
+                raise _IndexUnavailable("index_changed_during_snapshot")
+            connection = sqlite3.connect(
+                snapshot.as_uri() + "?mode=ro", uri=True, timeout=0.1
+            )
+            try:
+                connection.execute("PRAGMA query_only=ON")
+                connection.execute("PRAGMA trusted_schema=OFF")
+                connection.execute("PRAGMA temp_store=MEMORY")
+                connection.execute("PRAGMA cache_size=-2048")
+                connection.set_progress_handler(
+                    lambda: int(control.reason() is not None), 500
+                )
+                table = connection.execute(
+                    "SELECT type FROM sqlite_master WHERE name='threads'"
+                ).fetchone()
+                columns = {
+                    row[1] for row in connection.execute('PRAGMA table_info("threads")')
+                }
+                if not table or table[0] != "table" or not {
+                    "id", "rollout_path", "updated_at", "archived"
+                } <= columns:
+                    raise _IndexUnavailable("index_schema_unsupported")
+                # Titles, messages, accounts, auth and read receipts are never
+                # selected. LIMIT also bounds candidate materialization.
+                rows = connection.execute(
+                    'SELECT "id","rollout_path" FROM "threads" '
+                    'WHERE "archived"=0 ORDER BY "updated_at" DESC,"id" ASC LIMIT ?',
+                    (limit * 8,),
+                ).fetchall()
+            finally:
+                connection.close()
+        control.check()
+    except _Stop:
+        raise
+    except _IndexUnavailable:
+        raise
+    except (OSError, ValueError, sqlite3.Error):
+        control.check()
+        raise _IndexUnavailable("index_snapshot_unavailable") from None
+    selected: list[_File] = []
+    seen_ids: set[str] = set()
+    seen_paths: set[Path] = set()
+    for thread_id, stored in rows:
+        control.check()
+        if not isinstance(thread_id, str) or not isinstance(stored, str):
+            result["rejectedCandidates"] += 1
+            continue
+        if thread_id in seen_ids:
+            continue
+        try:
+            path = Path(stored)
+            try:
+                item = _file(home, path, conversation=True)
+            except FileNotFoundError:
+                if not stored.casefold().endswith(".jsonl"):
+                    raise
+                item = _file(home, Path(stored + ".zst"), conversation=True)
+            if item.path in seen_paths:
+                continue
+        except (OSError, ValueError):
+            result["rejectedCandidates"] += 1
+            continue
+        selected.append(item)
+        seen_ids.add(thread_id)
+        seen_paths.add(item.path)
+        if len(selected) >= limit:
+            break
+    result["selectionSource"] = "state_db_snapshot_updated_at"
+    _warn(result, "snapshot_is_not_atomic_live_state")
+    return selected
+
+
+def _filesystem_candidates(
+    home: Path, limit: int, max_entries: int, control: _Control, result: dict[str, Any]
+) -> list[_File]:
+    """Bounded fallback confined to sessions; recency means file mtime here."""
+    root = home / "sessions"
+    info = root.lstat()
+    if _linked(info) or not stat.S_ISDIR(info.st_mode):
+        raise ValueError("Sessions must be an ordinary directory")
+    pending = [(root, 0)]
+    heap: list[tuple[int, int, _File]] = []
+    inspected = 0
+    while pending and inspected < max_entries:
+        control.check()
+        directory, depth = pending.pop()
+        try:
+            with os.scandir(directory) as entries:
+                for entry in entries:
+                    control.check()
+                    inspected += 1
+                    if inspected > max_entries:
+                        break
+                    try:
+                        info = entry.stat(follow_symlinks=False)
+                        if _linked(info):
+                            result["rejectedCandidates"] += 1
+                            continue
+                        if stat.S_ISDIR(info.st_mode):
+                            if depth < _MAX_SCAN_DEPTH:
+                                pending.append((Path(entry.path), depth + 1))
+                            else:
+                                _warn(result, "discovery_depth_limit")
+                            continue
+                        if not entry.name.casefold().endswith((".jsonl", ".jsonl.zst")):
+                            continue
+                        item = _file(home, Path(entry.path), conversation=True)
+                        value = (item.mtime_ns, inspected, item)
+                        if len(heap) < limit:
+                            heapq.heappush(heap, value)
+                        elif value[:2] > heap[0][:2]:
+                            heapq.heapreplace(heap, value)
+                    except (OSError, ValueError):
+                        result["rejectedCandidates"] += 1
+        except OSError:
+            _warn(result, "sessions_directory_unreadable")
+    if pending or inspected >= max_entries:
+        _warn(result, "discovery_entry_limit")
+    result["selectionSource"] = "sessions_file_mtime"
+    _warn(result, "file_mtime_is_not_conversation_recency")
+    return [value[2] for value in sorted(heap, reverse=True)]
+
+
+def _prefetch(
+    home: Path,
+    item: _File,
+    allowance: int,
+    control: _Control,
+    result: dict[str, Any],
+    progress: Callable | None,
+) -> None:
+    count = 0
+    complete = False
+    changed = False
+    try:
+        with _reader(home, item) as handle:
+            if item.size <= allowance:
+                ranges = [(0, item.size)]
+            else:
+                # Share the budget fairly across the 50 selections; for a long
+                # history, read its beginning and end rather than only the prefix.
+                first = (allowance + 1) // 2
+                ranges = [(0, first), (item.size - (allowance - first), allowance - first)]
+            for offset, length in ranges:
+                handle.seek(offset)
+                remaining = length
+                while remaining:
+                    control.check()
+                    chunk = handle.read(min(_CHUNK, remaining))
+                    if not chunk:
+                        changed = True
+                        break
+                    count += len(chunk)
+                    result["bytesRead"] += len(chunk)
+                    remaining -= len(chunk)
+                    _emit(result, control, progress, "reading")
+            changed |= not _unchanged(os.fstat(handle.fileno()), item)
+            complete = not changed and count == item.size
+    finally:
+        if complete or count:
+            result["filesRead"] += 1
+            if not complete:
+                result["partialFiles"] += 1
+        if changed:
+            result["changedFiles"] += 1
+            if not count:
+                result["skipped"] += 1
+
+
+def warm_recent_conversations(
+    codex_home: Path | str,
+    *,
+    limit: int = 50,
+    cancel: Any = None,
+    progress: Callable[[dict[str, Any]], None] | None = None,
+    max_bytes: int = DEFAULT_TOTAL_BYTES,
+    max_file_bytes: int = DEFAULT_FILE_BYTES,
+    max_index_bytes: int = DEFAULT_INDEX_BYTES,
+    max_seconds: float = DEFAULT_SECONDS,
+    max_scan_entries: int = _MAX_SCAN_ENTRIES,
+) -> dict[str, Any]:
+    """Pre-read recent local files after an explicit user action.
+
+    ``cancel`` accepts a threading.Event or a zero-argument predicate. Progress and
+    results are aggregate dictionaries, safe to show without redacting paths or
+    conversation content. Bounds include discovery time; cancellation is checked
+    between metadata/read chunks (a blocking OS read cannot be preempted).
+
+    The optional local snapshot includes DB+WAL, never SHM or credentials, and is
+    removed before conversation reading. If it cannot be stabilized within its
+    bound, fallback selection uses file mtimes and reports this limitation.
+    """
+    if not isinstance(limit, int) or isinstance(limit, bool) or not 1 <= limit <= _MAX_THREADS:
+        raise ValueError("limit must be between 1 and 50")
+    for value in (max_bytes, max_file_bytes, max_index_bytes, max_scan_entries):
+        if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+            raise ValueError("All size and discovery limits must be positive integers")
+    if not 0 < max_seconds <= 3600:
+        raise ValueError("max_seconds must be between 0 and 3600")
+    if cancel is not None and not callable(cancel) and not callable(
+        getattr(cancel, "is_set", None)
+    ):
+        raise TypeError("cancel must be a predicate or an Event")
+    control = _Control(cancel, max_seconds)
+    result: dict[str, Any] = {
+        "schemaVersion": 1,
+        "mode": "os_file_cache",
+        "applicationPreloadSupported": False,
+        "applicationCacheLoaded": False,
+        "persistentCache": False,
+        "speedupMeasured": False,
+        "sourceReadOnly": True,
+        "status": "completed",
+        "selected": 0,
+        "filesRead": 0,
+        "partialFiles": 0,
+        "changedFiles": 0,
+        "skipped": 0,
+        "rejectedCandidates": 0,
+        "bytesRead": 0,
+        "metadataBytesRead": 0,
+        "selectionSource": "none",
+        "warnings": [],
+        "limitingFactors": [],
+        "limits": {
+            "conversations": limit,
+            "readBytes": max_bytes,
+            "bytesPerFile": max_file_bytes,
+            "indexBytes": max_index_bytes,
+            "seconds": max_seconds,
+            "discoveryEntries": max_scan_entries,
+        },
+    }
+    try:
+        control.check()
+        home = _home_path(codex_home)
+        _emit(result, control, progress, "discovering")
+        try:
+            candidates = _database_candidates(
+                home, limit, max_index_bytes, control, result
+            )
+        except _IndexUnavailable as exc:
+            _warn(result, exc.reason)
+            candidates = _filesystem_candidates(
+                home, limit, max_scan_entries, control, result
+            )
+        result["selected"] = len(candidates)
+        if not candidates:
+            _warn(result, "no_eligible_conversations")
+        _emit(result, control, progress, "reading")
+        for index, item in enumerate(candidates):
+            control.check()
+            remaining = max_bytes - result["bytesRead"]
+            if remaining <= 0:
+                raise _Stop("byte_budget")
+            allowance = min(
+                max_file_bytes, remaining, max(1, remaining // (len(candidates) - index))
+            )
+            if item.size > allowance:
+                reason = "per_file_byte_budget" if allowance == max_file_bytes else "byte_budget"
+                if reason not in result["limitingFactors"]:
+                    result["limitingFactors"].append(reason)
+            files_read_before = result["filesRead"]
+            try:
+                _prefetch(home, item, allowance, control, result, progress)
+            except (OSError, ValueError):
+                if result["filesRead"] == files_read_before:
+                    result["skipped"] += 1
+                _warn(result, "conversation_unreadable_or_changed")
+            _emit(result, control, progress, "reading")
+    except _Stop as exc:
+        result["status"] = "cancelled" if exc.reason == "cancelled" else "limited"
+        if exc.reason != "cancelled" and exc.reason not in result["limitingFactors"]:
+            result["limitingFactors"].append(exc.reason)
+    except (OSError, ValueError):
+        result["status"] = "unavailable"
+        _warn(result, "local_codex_directory_unavailable")
+    if result["status"] == "completed" and (
+        result["partialFiles"]
+        or result["changedFiles"]
+        or result["skipped"]
+        or result["limitingFactors"]
+        or any(
+            reason in result["warnings"]
+            for reason in ("discovery_entry_limit", "discovery_depth_limit")
+        )
+    ):
+        result["status"] = "limited"
+    result["elapsedSeconds"] = round(time.monotonic() - control.started, 3)
+    _emit(result, control, progress, "finished")
+    return result
