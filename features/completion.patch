new file mode 100644
index 0000000..55e9507
--- /dev/null
+++ b/src/codex_transfer/resume_discovery.py
@@ -0,0 +1,113 @@
+"""Read-only discovery of local, unfinished restore plans.
+
+Discovery loads metadata only. It never opens a checkpoint database, scans a
+backup or starts a restoration. A separate user action is required to resume.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+import os
+from pathlib import Path
+import stat
+
+MAX_DOCUMENT_BYTES = 1_048_576
+RESUMABLE_STATES = frozenset({"prepared", "restoring", "paused"})
+
+
+@dataclass(frozen=True)
+class ResumeCandidate:
+    document: Path
+    package: Path
+    target: Path
+    status: str
+    updated_ns: int
+    source_available: bool
+
+
+def _plain_path(path: Path) -> None:
+    info = path.lstat()
+    if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+        raise ValueError("Resume metadata must not be a symlink or reparse point")
+
+
+def _read_object(path: Path) -> dict:
+    _plain_path(path)
+    with path.open("rb") as handle:
+        raw = handle.read(MAX_DOCUMENT_BYTES + 1)
+    if len(raw) > MAX_DOCUMENT_BYTES:
+        raise ValueError("Resume metadata is larger than the supported limit")
+    value = json.loads(raw)
+    if not isinstance(value, dict):
+        raise ValueError("Resume metadata must be an object")
+    return value
+
+
+def _absolute(value: object) -> Path:
+    if not isinstance(value, str) or not value or not Path(value).is_absolute():
+        raise ValueError("Resume metadata needs absolute source and target paths")
+    return Path(value).resolve(strict=False)
+
+
+def inspect_resume_plan(document: Path, *, expected_profile: Path) -> ResumeCandidate:
+    document = Path(document).absolute()
+    _plain_path(document.parent)
+    state = _read_object(document)
+    if state.get("resumeVersion") != 1:
+        raise ValueError("Unsupported resume plan version")
+    journal_path = document.parent / "restore-journal.json"
+    journal = _read_object(journal_path)
+    target = _absolute(state.get("targetProfile"))
+    package = _absolute(state.get("package"))
+    if target != Path(expected_profile).resolve(strict=False):
+        raise ValueError("This plan belongs to a different destination profile")
+    if (_absolute(journal.get("targetProfile")) != target
+            or _absolute(journal.get("package")) != package
+            or _absolute(journal.get("safetyRoot")) != document.parent.resolve()
+            or journal.get("resumeExternalRoots") != state.get("externalRoots")):
+        raise ValueError("Resume plan and original restore journal do not match")
+    status = journal.get("status")
+    if status not in RESUMABLE_STATES:
+        raise ValueError("This restore is already complete or no longer resumable")
+    return ResumeCandidate(document.resolve(), package, target, status,
+                           journal_path.stat().st_mtime_ns, package.is_dir())
+
+
+def discover_resume_plans(profile: Path, *, recovery_root: Path | None = None,
+                          max_points: int = 1000) -> tuple[list[ResumeCandidate], list[str]]:
+    """Inspect only direct children of the managed recovery directory.
+
+    The most recently updated valid plan comes first. Offline backups remain
+    visible, but cannot be resumed until they are available again.
+    """
+    if max_points < 1:
+        raise ValueError("max_points must be positive")
+    if recovery_root is None:
+        from . import windows
+        recovery_root = windows.recovery_points_folder(profile)
+    root = Path(recovery_root)
+    candidates, issues = [], []
+    try:
+        _plain_path(root)
+        with os.scandir(root) as entries:
+            for number, entry in enumerate(entries):
+                if number >= max_points:
+                    issues.append("Recovery discovery limit reached; use Load plan for older points.")
+                    break
+                if not entry.is_dir(follow_symlinks=False):
+                    continue
+                folder = Path(entry.path)
+                document = folder / "resume-plan.json"
+                if not document.exists():
+                    continue
+                try:
+                    candidates.append(inspect_resume_plan(document, expected_profile=profile))
+                except (OSError, ValueError, TypeError, KeyError, RuntimeError) as exc:
+                    # Local activity log only; no document contents in diagnostics.
+                    issues.append(f"Ignored recovery point {folder.name}: {type(exc).__name__}: {exc}")
+    except FileNotFoundError:
+        return [], []
+    except (OSError, ValueError) as exc:
+        return [], [f"Recovery plans unavailable: {type(exc).__name__}"]
+    candidates.sort(key=lambda item: (item.updated_ns, str(item.document)), reverse=True)
+    return candidates, issues
