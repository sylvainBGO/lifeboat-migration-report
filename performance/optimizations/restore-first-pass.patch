@@ -0,0 +1,72 @@
+"""Bounded native copies into a new staging directory, never an active target."""
+from collections import deque
+from concurrent.futures import ThreadPoolExecutor
+import os
+from pathlib import Path
+import shutil
+
+try:
+    from .space_budget import CopySpaceBudget
+except ImportError:
+    from space_budget import CopySpaceBudget
+
+
+def copy_staging_tree(source, destination, probe, workers=4, copy=shutil.copy2):
+    """Drain all writers before propagating errors so rollback cannot race them.
+
+    Only the coordinator creates directories and accounts for space. The queue
+    bounds memory independently of the source file count. Pending reservations
+    include completed-but-not-collected copies (conservative).
+    """
+    pending = deque()
+    reserved_bytes = 0
+    reserved_files = 0
+    count = total = 0
+
+    def reserved_probe(target, size, files):
+        credit, unit = probe(target, size + reserved_bytes, files + reserved_files)
+        return credit - reserved_bytes - reserved_files * unit, unit
+
+    guard = CopySpaceBudget(reserved_probe)
+
+    def collect():
+        nonlocal reserved_bytes, reserved_files, count, total
+        future, size = pending.popleft()
+        future.result()
+        reserved_bytes -= size
+        reserved_files -= 1
+        count += 1
+        total += size
+
+    # Context shutdown waits even on enumeration, space-check or worker errors.
+    with ThreadPoolExecutor(max_workers=workers) as executor:
+        try:
+            stack = [(Path(source), Path(destination))]
+            while stack:
+                current, target_dir = stack.pop()
+                target_dir.mkdir(parents=True, exist_ok=True)
+                with os.scandir(current) as entries:
+                    for entry in entries:
+                        target = target_dir / entry.name
+                        if entry.is_symlink() or (
+                            hasattr(entry, 'is_junction') and entry.is_junction()
+                        ):
+                            raise OSError(f'Link in staged project source: {entry.path}')
+                        if entry.is_dir(follow_symlinks=False):
+                            stack.append((Path(entry.path), target))
+                        elif entry.is_file(follow_symlinks=False):
+                            if len(pending) >= workers * 2:
+                                collect()
+                            size = entry.stat(follow_symlinks=False).st_size
+                            guard(Path(entry.path), target, size)
+                            future = executor.submit(copy, entry.path, target)
+                            pending.append((future, size))
+                            reserved_bytes += size
+                            reserved_files += 1
+            while pending:
+                collect()
+        except BaseException:
+            for future, _ in pending:
+                future.cancel()
+            raise
+    return count, total
