index 0000000..65f051c
--- /dev/null
+++ b/src/codex_transfer/restore_checkpoint.py
@@ -0,0 +1,159 @@
+"""Durable checkpoints for resumable staging, independent of GUI state.
+
+This is an internal building block, not a replacement for the restore journal.
+Completed rows mean a copy returned successfully, NOT that verification passed.
+One coordinator owns the ledger; copy workers must never call it.
+"""
+import json
+import os
+from pathlib import Path
+import sqlite3
+import threading
+
+
+PAUSE_RESERVE_BYTES = 500_000_000
+
+
+class RestorePaused(Exception):
+    """Cooperative stop after writers have drained; must not trigger rollback."""
+
+
+class CheckpointBusy(RuntimeError):
+    pass
+
+
+class CopyCheckpoint:
+    """Single-writer, bounded-memory copy ledger with restartable batches.
+
+    Graceful pauses commit every successful in-flight copy. Abrupt termination
+    can replay at most a batch plus the bounded worker queue. Skipping recorded
+    files assumes exclusive ownership of the staging tree; final hashes remain
+    required. Paths bind a ledger to one source/staging pair without a scan.
+    """
+
+    def __init__(self, path, source, destination, batch_size=256):
+        if batch_size < 1:
+            raise ValueError('batch_size must be positive')
+        self.path = Path(path)
+        self._source_input = Path(source).absolute()
+        self.source = Path(source).resolve()
+        self.destination = Path(destination).resolve()
+        self.batch_size = batch_size
+        self._pending = 0
+        self._pause = threading.Event()
+        self._db = None
+        self._lock = None
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            self._acquire_lock()
+            self._db = sqlite3.connect(self.path)
+            # This is recovery state, unlike the disposable manifest index.
+            self._db.execute('PRAGMA synchronous=FULL')
+            self._db.execute('PRAGMA journal_mode=DELETE')
+            self._db.execute('PRAGMA cache_size=-2048')
+            self._db.execute('CREATE TABLE IF NOT EXISTS metadata '
+                             '(key TEXT PRIMARY KEY, value TEXT NOT NULL)')
+            self._db.execute('CREATE TABLE IF NOT EXISTS completed '
+                             '(path TEXT PRIMARY KEY, size INTEGER NOT NULL)')
+            identity = json.dumps([1, str(self.source), str(self.destination)])
+            stored = self._db.execute(
+                "SELECT value FROM metadata WHERE key='identity'").fetchone()
+            if stored is not None and stored[0] != identity:
+                raise ValueError('Checkpoint belongs to a different copy operation')
+            self._db.execute("INSERT OR IGNORE INTO metadata VALUES ('identity', ?)",
+                             (identity,))
+            self._db.commit()
+        except BaseException:
+            self.close()
+            raise
+
+    def _acquire_lock(self):
+        self._lock = open(str(self.path) + '.lock', 'a+b')
+        # Lock one existing byte on Windows. The persistent lock file is harmless;
+        # the OS releases the lock when the owning process exits or crashes.
+        self._lock.seek(0, os.SEEK_END)
+        if self._lock.tell() == 0:
+            self._lock.write(b'0')
+            self._lock.flush()
+        self._lock.seek(0)
+        try:
+            if os.name == 'nt':
+                import msvcrt
+                msvcrt.locking(self._lock.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(self._lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            self._lock.close()
+            self._lock = None
+            raise CheckpointBusy('This copy operation is already running') from exc
+
+    def request_pause(self):
+        """Thread-safe entry point for the future GUI button."""
+        self._pause.set()
+
+    def check(self):
+        if self._pause.is_set():
+            raise RestorePaused('Manual pause requested')
+
+    def space_probe(self, probe):
+        """Adapt a raw (free bytes, allocation unit) probe to CopySpaceBudget."""
+        def check_space(target, size, files):
+            self.check()
+            free, unit = probe(target)
+            required = PAUSE_RESERVE_BYTES + max(0, size) + max(0, files) * unit
+            if free < required:
+                raise RestorePaused(
+                    f'Insufficient space: {free} bytes free; {required} required '
+                    f'including the {PAUSE_RESERVE_BYTES}-byte reserve')
+            return free - PAUSE_RESERVE_BYTES, unit
+        return check_space
+
+    def _key(self, source):
+        source = Path(source).absolute()
+        try:
+            relative = source.relative_to(self.source)
+        except ValueError:
+            # Windows may supply an 8.3 root while resolve() expands it. Accept
+            # the original root spelling as well, without resolving every file.
+            relative = source.relative_to(self._source_input)
+        if '..' in relative.parts:
+            raise ValueError('Checkpoint item escapes its source root')
+        return relative.as_posix()
+
+    def done(self, source):
+        return self._db.execute('SELECT size FROM completed WHERE path=?',
+                                (self._key(source),)).fetchone()
+
+    def complete(self, source, size):
+        self._db.execute('INSERT OR REPLACE INTO completed VALUES (?, ?)',
+                         (self._key(source), size))
+        self._pending += 1
+        if self._pending >= self.batch_size:
+            self.flush()
+
+    def flush(self):
+        self._db.commit()
+        self._pending = 0
+
+    def summary(self):
+        count, size = self._db.execute(
+            'SELECT COUNT(*), COALESCE(SUM(size),0) FROM completed').fetchone()
+        return {'files': count, 'bytes': size}
+
+    def close(self):
+        try:
+            if self._db is not None:
+                # Never turn uncommitted work into completed work merely by closing.
+                self._db.close()
+        finally:
+            self._db = None
+            if self._lock is not None:
+                self._lock.close()
+                self._lock = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.close()
