+"""Recovery controls and structured progress; Tk calls stay on the UI thread."""
+from pathlib import Path
+import threading
+import tkinter as tk
+from tkinter import ttk, filedialog, messagebox
+
+from . import defender_control, restore_operation, backup
+
+PHASES = ['restore projects', 'apply destination project decisions',
+          'build restored database', 'reset paginated history projection',
