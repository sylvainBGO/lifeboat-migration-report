new file mode 100644
index 0000000..91865ad
--- /dev/null
+++ b/src/codex_transfer/restore_operation.py
@@ -0,0 +1,176 @@
+"""Operation-level durable checkpoints. No source-wide preflight on resume."""
+from contextvars import ContextVar
+from functools import wraps
+import json
+import os
+from pathlib import Path
+import shutil
+import threading
+import time
+
+from .restore_checkpoint import CopyCheckpoint, RestorePaused, PAUSE_RESERVE_BYTES
+
+CURRENT = ContextVar('lifeboat_restore_operation', default=None)
+
+
+class RestoreOperation:
+    def __init__(self, safety, package, target, pause=None, progress=None):
+        self.safety = Path(safety)
+        self.ledger = CopyCheckpoint(self.safety / 'operation-checkpoints.sqlite', package, target)
+        self.db = self.ledger._db
+        self.db.execute('CREATE TABLE IF NOT EXISTS tasks '
+                        '(key TEXT PRIMARY KEY, result TEXT NOT NULL)')
+        self.db.commit()
+        self.pause = pause or threading.Event()
+        self.progress = progress
+        self.phase = ''
+        self.pending = 0
+        self.last_emit = 0
+        self.phase_count = 0
+        self.phase_start = time.monotonic()
+        self.token = None
+
+    def __enter__(self):
+        self.token = CURRENT.set(self)
+        return self
+
+    def __exit__(self, *_):
+        CURRENT.reset(self.token)
+        self.ledger.close()
+
+    def check(self):
+        if self.pause.is_set():
+            raise RestorePaused('Pause requested; completed work has been saved.')
+
+    def saved(self, key):
+        row = self.db.execute('SELECT result FROM tasks WHERE key=?', (key,)).fetchone()
+        return (row is not None, json.loads(row[0]) if row else None)
+
+    def save(self, key, value, durable=True):
+        self.db.execute('INSERT OR REPLACE INTO tasks VALUES (?,?)',
+                        (key, json.dumps(value, ensure_ascii=False)))
+        self.pending += 1
+        if durable or self.pending >= 64:
+            self.flush()
+
+    def flush(self):
+        self.db.commit()
+        self.pending = 0
+
+    def run(self, key, function, durable=True):
+        self.check()
+        found, value = self.saved(key)
+        if found:
+            return value
+        self.save('current-operation', {'phase': self.phase, 'task': key}) if durable else None
+        result = function()
+        self.save(key, result, durable)
+        return result
+
+    def emit(self, current, total, message, force=False):
+        now = time.monotonic()
+        if self.progress and (force or now-self.last_emit >= .2):
+            self.progress({'phase': self.phase, 'current': current, 'total': total,
+                           'message': message, 'phaseSeconds': now-self.phase_start})
+            self.last_emit = now
+
+    def file(self, key, function):
+        value = self.run('file:' + self.phase + ':' + key, function, durable=False)
+        self.phase_count += 1
+        self.emit(self.phase_count, 0, f'{self.phase}: {self.phase_count} files processed')
+        return value
+
+    def install(self, source, destination):
+        key = 'database-installed'
+        if self.saved(key)[0]:
+            return
+        self.check()
+        self.save('database-install-intent', [str(source), str(destination)])
+        if source.exists():
+            os.replace(source, destination)
+        elif not destination.exists():
+            raise RuntimeError('Neither prepared nor installed database exists')
+        self.save(key, True)
+
+
+def phase(function):
+    @wraps(function)
+    def wrapped(*args, **kwargs):
+        operation = CURRENT.get()
+        if operation is None:
+            return function(*args, **kwargs)
+        key = 'phase:' + function.__name__
+        operation.phase = function.__name__.removeprefix('_').replace('_', ' ')
+        operation.phase_count = 0
+        operation.phase_start = time.monotonic()
+        operation.emit(0, 0, operation.phase, True)
+        started = time.monotonic()
+        result = operation.run(key, lambda: function(*args, **kwargs))
+        operation.save('timing:' + key, time.monotonic()-started)
+        operation.emit(1, 1, operation.phase + ' complete', True)
+        return result
+    return wrapped
+
+
+def file_task(function):
+    @wraps(function)
+    def wrapped(source, destination, *args, **kwargs):
+        operation = CURRENT.get()
+        if operation is None:
+            return function(source, destination, *args, **kwargs)
+        key = json.dumps([function.__name__, str(source), str(destination)])
+        return operation.file(key, lambda: function(source, destination, *args, **kwargs))
+    return wrapped
+
+
+def clear_once(path, remove):
+    operation = CURRENT.get()
+    if operation is None:
+        remove(path)
+    else:
+        operation.run('clear:' + operation.phase + ':' + str(path), lambda: remove(path))
+
+
+@file_task
+def copy_file(source, target):
+    from . import restore
+    if CURRENT.get() is None:
+        from . import backup
+        return backup.copy_file(source, target)
+    restore._ensure_restore_space(target, source.stat().st_size, 1)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temporary = target.with_name('.' + target.name + '.lifeboat-copy.tmp')
+    shutil.copy2(source, temporary)
+    os.replace(temporary, target)
+
+
+def check_stream_space(target):
+    operation = CURRENT.get()
+    if operation is not None:
+        operation.check()
+        from . import restore
+        restore._ensure_restore_space(target, 1024 * 1024, 1)
+
+
+def resume_from_document(document, pause=None, progress=None, log=None):
+    from . import backup, restore
+    document = Path(document).resolve()
+    state = backup.read_json(document)
+    if state.get('resumeVersion') != 1:
+        raise ValueError('Unsupported resume document')
+    safety = document.parent
+    package, target = Path(state['package']), Path(state['targetProfile'])
+    backup.check_codex_not_running(target / '.codex', False)
+    with RestoreOperation(safety, package, target, pause, progress):
+        return restore.restore_backup(package, target, safety, log,
+                                      external_roots=state.get('externalRoots'))
+
+
+def create_document(safety, package, target, external_roots=None):
+    from . import backup
+    path = Path(safety) / 'resume-plan.json'
+    backup.write_json(path, {'resumeVersion': 1, 'package': str(Path(package).resolve()),
+                            'targetProfile': str(Path(target).resolve()),
+                            'externalRoots': external_roots or {},
+                            'reserveBytes': PAUSE_RESERVE_BYTES})
+    return path
