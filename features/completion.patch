+                                target.write(chunk)
+                        if (written != entry["size"]
+                                or not _source_unchanged(before, os.fstat(source_handle.fileno()))
+                                or not _source_unchanged(before, path.lstat())):
+                            raise ArchiveError(f"Project source changed during archiving: {path}")
+                        entry["sha256"] = digest.hexdigest()
+                        count += 1
+                        size += written
+                        block_size += written
+                        if on_progress:
+                            on_progress(count, size)
+                    entries.append(entry)
+                    index_size += predicted
+                finally:
+                    if source_handle:
+                        source_handle.close()
+            finish_block()
+    finally:
+        if archive is not None:
+            archive.close()
+    return count, size, {"kind": STORAGE, "blocks": blocks, "metadata": "mode-mtime-ns-v1"}
