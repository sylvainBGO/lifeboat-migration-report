+"""Local detailed report, allowlisted shareable report and migration guidance."""
+from . import backup, windows
+
+
+def write_operation_report(operation, package, target):
+    journal = backup.read_json(operation.safety / 'restore-journal.json')
+    timings = {key.removeprefix('timing:phase:'): value
+               for key, raw in operation.db.execute(
+                   "SELECT key,result FROM tasks WHERE key >= 'timing:' AND key < 'timing;' ")
+               for value in [__import__('json').loads(raw)]}
+    _, current = operation.saved('current-operation')
+    detail = {'status': journal.get('status'), 'phaseSeconds': timings,
+              'currentOperation': current, 'lastSpaceSample': operation.last_space,
+              'pauseReason': journal.get('pauseReason'), 'error': journal.get('error'),
+              'resumeDocument': str(operation.safety / 'resume-plan.json')}
+    backup.write_json(operation.safety / 'operation-report.json', detail)
+    # Allowlisting, rather than replacing some usernames in an otherwise raw log,
+    # prevents project names, file paths, thread content and credentials leaking.
+    summary = {'schemaVersion': 1, 'status': journal.get('status'),
+               'phaseSeconds': timings,
+               'lastSpaceSample': operation.last_space,
+               'counts': {key: journal.get(key) for key in (
+                   'projectFilesCopied', 'portableFilesCopied', 'sessionsCopied',
+                   'attachmentsCopied', 'recentIndexEntries') if key in journal},
+               'verificationValid': journal.get('verification', {}).get('valid')}
+    backup.write_json(operation.safety / 'shareable-operation-summary.json', summary)
+    if journal.get('status') != 'complete':
+        return
+    folder = windows.documents_folder(target) / 'Codex Restore Reports'
+    folder.mkdir(parents=True, exist_ok=True)
+    backup.write_json(folder / ('operation-' + operation.safety.name + '.json'), detail)
+    source = backup.read_json(package / 'manifest' / 'package.json')['source']['profilePath']
+    text = f'''# After restoring Codex on this computer
+
+Old profile: {source}
+Current profile: {target}
+Codex folder: {target / '.codex'}
+
+Instructions to add to your central Codex instructions:
+
+This environment was restored onto a new computer. Replace the old profile
+prefix above with the current profile, preserving the remainder of each path
+(including paths written with /). Use the actual current project directory.
+Do not recreate the old profile or move files to reproduce old paths. If a
+mapped path is missing, report it and search only the relevant project.
+
+The original conversation text may still mention the former computer. Restoring
+files does not make every historical sentence a current environment instruction.
+Git worktree pointers and local remotes may need project-specific repair; review
+them in their project before changing them. Credentials copied from another
+computer may still require signing in again.
+
+## First opening of conversations
+
+Open recent conversations one at a time. Do not start many agent tasks to warm
+the history. Sequentially opening up to 50 recent conversations is an experimental
+usability check, not an implemented or guaranteed persistent preloading API.
+Compare first-open and second-open latency before considering automation. No
+messages are sent to conversations by Lifeboat.
+
+## Resume and reports
+
+Resume plan: {operation.safety / 'resume-plan.json'}
+Detailed local report: {operation.safety / 'operation-report.json'}
+Shareable summary without paths or conversation content:
+{operation.safety / 'shareable-operation-summary.json'}
+
+If you disabled Microsoft Defender real-time protection, reactivate it now.
