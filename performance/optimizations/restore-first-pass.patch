diff --git a/src/codex_transfer/space_budget.py b/src/codex_transfer/space_budget.py
new file mode 100644
index 0000000..8f40724
--- /dev/null
+++ b/src/codex_transfer/space_budget.py
@@ -0,0 +1,40 @@
+"""Bounded free-space sampling for a sequential tree copy.
+
+This is an estimate, not a filesystem reservation. Other processes can consume
+space between samples; normal write-error handling and rollback remain required.
+"""
+import time
+
+
+class CopySpaceBudget:
+    def __init__(self, probe, clock=time.monotonic):
+        self.probe = probe
+        self.clock = clock
+        self.credit = 0
+        self.unit = 0
+        self.files = 0
+        self.bytes = 0
+        self.checked_at = None
+        self.volume = None
+
+    def __call__(self, source, target, size):
+        size = max(0, size)
+        now = self.clock()
+        volume = target.anchor.casefold()
+        cost = size + self.unit
+        if (self.checked_at is None or volume != self.volume
+                or now - self.checked_at >= 1.0
+                or self.files >= 1024
+                or self.bytes + size >= 256 * 1024 * 1024
+                or cost > self.credit):
+            # Probe checks the pending file plus allocation overhead and reserve.
+            # Credit is remaining free space ABOVE the existing safety reserve.
+            self.credit, self.unit = self.probe(target, size, 1)
+            self.checked_at = now
+            self.volume = volume
+            self.files = 0
+            self.bytes = 0
+            cost = size + self.unit
+        self.credit -= cost
+        self.files += 1
+        self.bytes += size
diff --git a/src/codex_transfer/text_replace.py b/src/codex_transfer/text_replace.py
new file mode 100644
index 0000000..ec91144
--- /dev/null
+++ b/src/codex_transfer/text_replace.py
@@ -0,0 +1,20 @@
+"""Skip the ordered replacement loop when none of its inputs occurs.
+
+The prefilter must not replace the loop: replacements can cascade, and their
+order is part of the legacy restore format's semantics.
+"""
+import re
+
+
+class OrderedPathReplacer:
+    def __init__(self, replacements):
+        self.replacements = tuple(replacements)
+        self.pattern = (re.compile('|'.join(re.escape(old) for old, _ in replacements))
+                        if replacements else None)
+
+    def __call__(self, value):
+        if self.pattern is None or self.pattern.search(value) is None:
+            return value
+        for old, new in self.replacements:
+            value = value.replace(old, new)
+        return value
