+class ResumeDiscoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.profile = self.root / 'new-profile'
+        self.profile.mkdir()
+        self.backup = self.root / 'backup'
+        self.backup.mkdir()
+        self.points = self.root / 'points'
+        self.points.mkdir()
+
+    def plan(self, name='first', *, status='paused', target=None, package=None):
+        folder = self.points / name
+        folder.mkdir()
+        common = dict(package=str(package or self.backup), targetProfile=str(target or self.profile))
+        doc = dict(resumeVersion=1, externalRoots={}, **common)
+        journal = dict(status=status, safetyRoot=str(folder), resumeExternalRoots={}, **common)
+        (folder / 'resume-plan.json').write_text(json.dumps(doc), encoding='utf-8')
+        (folder / 'restore-journal.json').write_text(json.dumps(journal), encoding='utf-8')
+        return folder / 'resume-plan.json'
+
+    def test_only_unfinished_matching_plans_loaded_without_writing(self):
+        eligible = self.plan()
+        self.plan('complete', status='complete')
+        self.plan('rolledback', status='rolled-back')
+        self.plan('different-user', target=self.root / 'old-profile')
+        before = {str(p): p.read_bytes() for p in self.points.rglob('*.json')}
+        found, issues = discover_resume_plans(self.profile, recovery_root=self.points)
+        self.assertEqual([item.document for item in found], [eligible.resolve()])
+        self.assertTrue(found[0].source_available)
+        self.assertEqual(len(issues), 3)
+        self.assertEqual(before, {str(p): p.read_bytes() for p in self.points.rglob('*.json')})
+        self.assertFalse(list(self.points.rglob('*.sqlite')))
+
+    def test_newest_plan_selected_and_offline_source_kept_visible(self):
+        self.plan('older')
+        latest = self.plan('newer', package=self.root / 'offline')
+        os.utime(latest.parent / 'restore-journal.json', ns=(9_000_000_000, 9_000_000_000))
+        os.utime(self.points / 'older' / 'restore-journal.json', ns=(1_000_000_000, 1_000_000_000))
+        found, issues = discover_resume_plans(self.profile, recovery_root=self.points)
+        self.assertFalse(issues)
+        self.assertEqual(found[0].document, latest.resolve())
+        self.assertFalse(found[0].source_available)
+
+    def test_mismatched_journal_and_oversized_or_invalid_documents_rejected(self):
+        document = self.plan()
+        original = json.loads(document.read_text())
+        document.write_text(json.dumps(dict(original, package=str(self.root / 'different'))))
+        with self.assertRaises(ValueError):
+            inspect_resume_plan(document, expected_profile=self.profile)
+        document.write_bytes(b' ' * (1_048_576 + 1))
+        with self.assertRaises(ValueError):
+            inspect_resume_plan(document, expected_profile=self.profile)
+        document.write_text('[]')
+        with self.assertRaises(ValueError):
+            inspect_resume_plan(document, expected_profile=self.profile)
+
+    def test_symlinked_metadata_not_followed(self):
+        document = self.plan()
+        target = self.root / 'outside.json'
+        target.write_bytes(document.read_bytes())
+        document.unlink()
+        try:
+            document.symlink_to(target)
+        except OSError:
+            self.skipTest('Host cannot create symlinks')
+        with self.assertRaises(ValueError):
+            inspect_resume_plan(document, expected_profile=self.profile)
