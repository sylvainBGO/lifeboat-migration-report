+"""Local warmup contracts, on synthetic profiles only."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from codex_transfer import conversation_warmup as warmup
+
+
+class ConversationWarmupTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="warmup-test-")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.home = self.root / "profile" / ".codex"
+        self.sessions = self.home / "sessions" / "2026" / "11" / "08"
+        self.sessions.mkdir(parents=True)
+        self.database = self.home / "state_5.sqlite"
+        self.sensitive = "DO-NOT-EXPORT-THIS-TITLE-OR-CONTENT"
+
+    def rollout(self, name: str, size: int = 100, *, mtime: int = 100) -> Path:
+        path = self.sessions / f"rollout-{name}.jsonl"
+        path.write_bytes((self.sensitive.encode() * (1 + size // len(self.sensitive)))[:size])
+        os.utime(path, ns=(mtime * 10**9, mtime * 10**9))
+        return path
+
+    def connect(self, *, wal: bool = False):
+        connection = sqlite3.connect(self.database)
+        if wal:
+            connection.execute("PRAGMA journal_mode=WAL")
+            connection.execute("PRAGMA wal_autocheckpoint=0")
+        connection.execute(
+            "CREATE TABLE threads (id TEXT PRIMARY KEY, rollout_path TEXT, "
+            "updated_at INTEGER, archived INTEGER, title TEXT)"
+        )
+        connection.commit()
+        return connection
+
+    def add(self, connection, name, path, updated, archived=0):
+        connection.execute(
+            "INSERT INTO threads VALUES (?,?,?,?,?)",
+            (name, str(path), updated, archived, self.sensitive),
+        )
+        connection.commit()
+
+    def signature(self):
+        return {
+            str(path.relative_to(self.home)): (
+                path.stat().st_mtime_ns,
+                hashlib.sha256(path.read_bytes()).hexdigest(),
+            )
+            for path in self.home.rglob("*")
+            if path.is_file() and not path.is_symlink()
+        }
+
+    def test_selects_latest_database_update_and_does_not_change_source(self):
+        old = self.rollout("old", 11, mtime=999)
+        recent = self.rollout("recent", 37, mtime=100)
+        archived = self.rollout("archived", 90, mtime=1000)
+        with self.connect() as connection:
+            self.add(connection, "old-id", old, 10)
+            self.add(connection, "recent-id", recent, 20)
+            self.add(connection, "archive-id", archived, 30, archived=1)
+        connection.close()
+        (self.home / "auth.json").write_text(self.sensitive)
+        before = self.signature()
+        progress = []
+        result = warmup.warm_recent_conversations(self.home, limit=1, progress=progress.append)
+        self.assertEqual(result["status"], "completed")
+        self.assertEqual(result["selectionSource"], "state_db_snapshot_updated_at")
+        self.assertEqual((result["selected"], result["filesRead"], result["bytesRead"]), (1, 1, 37))
+        self.assertEqual(self.signature(), before)
+        serialized = json.dumps([result, progress])
+        for private in (self.sensitive, "recent-id", str(self.home), "rollout-recent"):
+            self.assertNotIn(private, serialized)
+        self.assertFalse(result["applicationPreloadSupported"])
+        self.assertFalse(result["applicationCacheLoaded"])
+        self.assertFalse(result["persistentCache"])
+        self.assertFalse(result["speedupMeasured"])
+
+    def test_active_wal_is_captured_without_writing_source_shm(self):
+        old = self.rollout("old", 13)
+        recent = self.rollout("wal-only", 41)
+        connection = self.connect(wal=True)
+        self.addCleanup(connection.close)
+        self.add(connection, "old", old, 10)
+        connection.execute("PRAGMA wal_checkpoint(TRUNCATE)")
+        self.add(connection, "recent-wal", recent, 20)
+        self.assertGreater((self.home / "state_5.sqlite-wal").stat().st_size, 0)
+        before = self.signature()
+        result = warmup.warm_recent_conversations(self.home, limit=1)
+        self.assertEqual(result["selectionSource"], "state_db_snapshot_updated_at")
+        self.assertEqual(result["bytesRead"], 41)
+        self.assertEqual(self.signature(), before)
+
+    def test_closed_wal_database_creates_no_original_sidecars(self):
+        item = self.rollout("closed-wal", 29)
+        connection = self.connect(wal=True)
+        self.add(connection, "id", item, 20)
+        connection.close()
+        self.assertFalse((self.home / "state_5.sqlite-wal").exists())
+        before = self.signature()
+        result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual(result["bytesRead"], 29)
+        self.assertEqual(self.signature(), before)
+
+    def test_snapshot_is_cleaned_and_uses_no_source_shm(self):
+        item = self.rollout("snapshot", 19)
+        connection = self.connect(wal=True)
+        self.addCleanup(connection.close)
+        self.add(connection, "id", item, 20)
+        private_temp = self.root / "private-temp"
+        private_temp.mkdir()
+        opened = []
+        original = warmup._reader
+
+        def inspect(home, value):
+            opened.append(value.path.name)
+            return original(home, value)
+
+        with patch.object(warmup.tempfile, "gettempdir", return_value=str(private_temp)), patch.object(
+            warmup, "_reader", side_effect=inspect
+        ):
+            result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual(result["status"], "completed")
+        self.assertEqual(list(private_temp.iterdir()), [])
+        self.assertNotIn("state_5.sqlite-shm", opened)
+        self.assertNotIn("auth.json", opened)
+
+    def test_changed_snapshot_falls_back_with_explicit_reason(self):
+        self.rollout("fallback", 17)
+        connection = self.connect()
+        connection.close()
+        original = warmup._copy_index_file
+
+        def change_source(*args):
+            original(*args)
+            with self.database.open("ab") as handle:
+                handle.write(b"changed-during-copy")
+
+        with patch.object(warmup, "_copy_index_file", side_effect=change_source):
+            result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual(result["selectionSource"], "sessions_file_mtime")
+        self.assertIn("index_changed_during_snapshot", result["warnings"])
+        self.assertIn("file_mtime_is_not_conversation_recency", result["warnings"])
+        self.assertEqual(result["bytesRead"], 17)
+
+    def test_index_size_budget_falls_back_without_copying_metadata(self):
+        self.rollout("fallback", 23)
+        connection = self.connect()
+        connection.close()
+        result = warmup.warm_recent_conversations(self.home, max_index_bytes=1)
+        self.assertEqual(result["selectionSource"], "sessions_file_mtime")
+        self.assertEqual(result["metadataBytesRead"], 0)
+        self.assertIn("index_byte_budget", result["warnings"])
+
+    def test_file_fallback_orders_by_mtime_and_excludes_archived(self):
+        self.rollout("older", 11, mtime=10)
+        self.rollout("newer", 37, mtime=20)
+        archive = self.home / "archived_sessions"
+        archive.mkdir()
+        (archive / "rollout-archived.jsonl").write_bytes(b"x" * 1000)
+        result = warmup.warm_recent_conversations(self.home, limit=1)
+        self.assertEqual(result["selectionSource"], "sessions_file_mtime")
+        self.assertEqual(result["bytesRead"], 37)
+
+    def test_reads_at_most_the_50_latest_conversations(self):
+        connection = self.connect()
+        for index in range(60):
+            self.add(connection, str(index), self.rollout(str(index), index + 1), index)
+        connection.close()
+        result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual(result["selected"], 50)
+        self.assertEqual(result["filesRead"], 50)
+        self.assertEqual(result["bytesRead"], sum(range(11, 61)))
+
+    def test_rejects_escape_old_profile_and_traversal(self):
+        valid = self.rollout("valid", 7)
+        outside = self.root / "old-profile" / ".codex" / "sessions" / "rollout-old.jsonl"
+        outside.parent.mkdir(parents=True)
+        outside.write_bytes(b"outside content")
+        with self.connect() as connection:
+            self.add(connection, "old-profile", outside, 100)
+            self.add(connection, "escape", "../outside.jsonl", 90)
+            self.add(connection, "traversal", "sessions/../auth.jsonl", 80)
+            self.add(connection, "valid", valid, 70)
+        connection.close()
+        result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual((result["selected"], result["bytesRead"]), (1, 7))
+        self.assertEqual(result["rejectedCandidates"], 3)
+
+    def test_rejects_symlink_in_session_tree(self):
+        external = self.root / "external.jsonl"
+        external.write_bytes(b"secret outside root")
+        linked = self.sessions / "rollout-linked.jsonl"
+        try:
+            linked.symlink_to(external)
+        except (OSError, NotImplementedError):
+            self.skipTest("Symlink creation is not permitted on this test host")
+        result = warmup.warm_recent_conversations(self.home)
+        self.assertEqual(result["bytesRead"], 0)
+        self.assertGreaterEqual(result["rejectedCandidates"], 1)
+
+    def test_rejects_reparse_points_even_when_reported_as_regular_files(self):
+        class Reparse:
+            st_mode = 0o100644
+            st_file_attributes = 0x400
+
+        self.assertTrue(warmup._linked(Reparse()))
+
+    def test_compressed_rollout_is_read_as_bounded_raw_bytes(self):
+        path = self.sessions / "rollout-compressed.jsonl.zst"
+        path.write_bytes(b"compressed-data-does-not-need-to-be-parsed" * 10)
+        with self.connect() as connection:
+            self.add(connection, "id", str(path)[:-4], 50)
+        connection.close()
+        result = warmup.warm_recent_conversations(self.home, max_file_bytes=31)
+        self.assertEqual(result["bytesRead"], 31)
+        self.assertEqual(result["partialFiles"], 1)
+        self.assertEqual(result["status"], "limited")
+
+    def test_global_read_budget_is_fair_and_hard(self):
+        for index in range(3):
+            self.rollout(str(index), 100, mtime=index + 1)
+        result = warmup.warm_recent_conversations(self.home, max_bytes=30, max_file_bytes=100)
+        self.assertEqual(result["bytesRead"], 30)
+        self.assertEqual(result["filesRead"], 3)
+        self.assertEqual(result["partialFiles"], 3)
+        self.assertEqual(result["status"], "limited")
+
+    def test_cancel_before_discovery_does_no_io(self):
+        event = threading.Event()
+        event.set()
+        with patch.object(warmup, "_home_path", side_effect=AssertionError("must not read")):
+            result = warmup.warm_recent_conversations(self.home, cancel=event)
+        self.assertEqual(result["status"], "cancelled")
+        self.assertEqual((result["bytesRead"], result["metadataBytesRead"]), (0, 0))
+
+    def test_cancel_during_read_stops_between_bounded_chunks(self):
+        self.rollout("long", warmup._CHUNK * 5)
+        event = threading.Event()
+
+        def progress(value):
+            if value["bytesRead"]:
+                event.set()
+
+        result = warmup.warm_recent_conversations(self.home, cancel=event, progress=progress)
+        self.assertEqual(result["status"], "cancelled")
+        self.assertEqual(result["bytesRead"], warmup._CHUNK)
+        self.assertEqual(result["partialFiles"], 1)
+
+    def test_cancel_during_snapshot_cleans_private_copy(self):
+        connection = self.connect()
+        connection.close()
+        event = threading.Event()
+        private_temp = self.root / "cancel-temp"
+        private_temp.mkdir()
+        original = warmup._copy_index_file
+        before = self.signature()
+
+        def cancel_after_copy(*args):
+            original(*args)
+            event.set()
+
+        with patch.object(warmup.tempfile, "gettempdir", return_value=str(private_temp)), patch.object(
+            warmup, "_copy_index_file", side_effect=cancel_after_copy
+        ):
+            result = warmup.warm_recent_conversations(self.home, cancel=event)
+        self.assertEqual(result["status"], "cancelled")
+        self.assertEqual(list(private_temp.iterdir()), [])
+        self.assertEqual(self.signature(), before)
+        self.assertEqual(result["bytesRead"], 0)
+
+    def test_time_budget_includes_discovery(self):
+        with patch.object(warmup.time, "monotonic", side_effect=[0.0, 2.0, 2.0]):
+            result = warmup.warm_recent_conversations(self.home, max_seconds=1)
+        self.assertEqual(result["status"], "limited")
+        self.assertIn("time_budget", result["limitingFactors"])
+        self.assertEqual(result["metadataBytesRead"], 0)
+
+    def test_discovery_is_bounded_even_without_an_index(self):
+        for number in range(20):
+            self.rollout(str(number), 10)
+        result = warmup.warm_recent_conversations(self.home, max_scan_entries=5)
+        self.assertIn("discovery_entry_limit", result["warnings"])
+        self.assertLessEqual(result["selected"], 5)
+
+    def test_file_disappearing_after_discovery_is_reported_without_paths(self):
+        path = self.rollout("remove", 9)
+
+        def progress(value):
+            if value["phase"] == "reading" and value["selected"]:
+                path.unlink(missing_ok=True)
+
+        result = warmup.warm_recent_conversations(self.home, progress=progress)
+        self.assertEqual(result["skipped"], 1)
+        self.assertEqual(result["bytesRead"], 0)
+        self.assertNotIn(str(path), json.dumps(result))
+
+    def test_invalid_limits_fail_before_io(self):
+        for arguments in ({"limit": 51}, {"max_bytes": 0}, {"max_seconds": -1}):
+            with self.subTest(arguments=arguments), self.assertRaises(ValueError):
+                warmup.warm_recent_conversations(self.home, **arguments)
+
+    def test_report_cannot_replace_source_or_any_existing_destination(self):
+        report = self.root / "already-exists.json"
+        report.write_text("keep existing report")
