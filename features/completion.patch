+            with self.subTest(path=path), self.assertRaises(ValueError):
+                warmup.validate_report_destination(self.home, path)
+        self.assertEqual(report.read_text(), "keep existing report")
+        self.assertFalse((self.home / "auth.json").exists())
+
+    def test_report_parent_symlink_cannot_enter_codex_home(self):
+        link = self.root / "report-alias"
+        try:
+            link.symlink_to(self.home, target_is_directory=True)
+        except (OSError, NotImplementedError):
+            self.skipTest("Symlink creation is not permitted on this test host")
+        with self.assertRaises(ValueError):
+            warmup.validate_report_destination(self.home, link / "new-report.json")
+        self.assertFalse((self.home / "new-report.json").exists())
+
+    def test_report_rejects_dangling_destination_symlink(self):
+        link = self.root / "dangling-report.json"
+        try:
+            link.symlink_to(self.root / "absent.json")
+        except (OSError, NotImplementedError):
+            self.skipTest("Symlink creation is not permitted on this test host")
+        with self.assertRaises(ValueError):
+            warmup.validate_report_destination(self.home, link)
+
+    def test_report_allows_new_local_path_without_creating_parents(self):
+        report = self.root / "new-directory" / "warmup-report.json"
+        result = warmup.validate_report_destination(self.home, report)
+        self.assertEqual(result, report.resolve(strict=False))
+        self.assertFalse(report.parent.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
