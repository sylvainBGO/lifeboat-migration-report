diff --git a/src/codex_transfer/owned_paths.py b/src/codex_transfer/owned_paths.py
new file mode 100644
index 0000000..ad13a53
--- /dev/null
+++ b/src/codex_transfer/owned_paths.py
@@ -0,0 +1,39 @@
+"""Remove already-authorized restore payloads, including Windows readonly files.
+
+Callers own path authorization. This helper never expands the deletion scope or
+retries ACL/sharing errors on ordinary writable objects.
+"""
+import os
+from pathlib import Path
+import shutil
+import stat
+
+
+def _retry_readonly(function, value, error):
+    if (os.name != "nt" or not isinstance(error, PermissionError)
+            or getattr(error, "winerror", None) != 5
+            or function not in {os.unlink, os.remove, os.rmdir}):
+        raise error
+    info = Path(value).lstat()
+    attributes = getattr(info, "st_file_attributes", 0)
+    if (not attributes & 0x1 or attributes & 0x400
+            or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode))):
+        raise error
+    os.chmod(value, stat.S_IMODE(info.st_mode) | stat.S_IWUSR)
+    function(value)
+
+
+def remove_path(path):
+    """Delete one previously approved path; propagate all non-readonly failures."""
+    path = Path(path)
+    if not path.exists() and not path.is_symlink():
+        return
+    if path.is_symlink() or path.is_file():
+        try:
+            os.unlink(path)
+        except OSError as exc:
+            _retry_readonly(os.unlink, path, exc)
+    else:
+        def onerror(function, value, exception_info):
+            _retry_readonly(function, value, exception_info[1])
+        shutil.rmtree(path, onerror=onerror)
diff --git a/src/codex_transfer/project_archives.py b/src/codex_transfer/project_archives.py
new file mode 100644
index 0000000..470d2d0
--- /dev/null
+++ b/src/codex_transfer/project_archives.py
@@ -0,0 +1,794 @@
+"""Opt-in, versioned project archives with streaming verification and extraction.
+
+The ordinary backup format remains unchanged. Format 2.5 replaces only project
+payload trees with bounded ZIP blocks; conversations and portable Codex data
+remain ordinary files. Every project file still has a logical SHA-256 row in the
+package manifest. Each physical block is hashed by that same manifest as well.
+
+ZIP filenames are generated object identifiers, never destination paths. A small
+bounded index records regular files/directories, their exact mtime_ns and their
+portable permission mode. ACLs, ADS, ownership, xattrs and links are not part of
+this storage contract. No ZIP extraction API is used.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager, suppress
+import csv
+import errno
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import sqlite3
+import stat
+import struct
+import tempfile
+import time
+import zipfile
+import zlib
+
+STORAGE = "archive-blocks-v1"
+FORMAT_VERSION = "2.5"
+INDEX_NAME = "lifeboat-index.json"
+MAX_BLOCK_ENTRIES = 1024
+MAX_BLOCK_BYTES = 128 * 1024 * 1024
+MAX_INDEX_BYTES = 4 * 1024 * 1024
+CHUNK_BYTES = 1024 * 1024
+TEMP_PREFIX = ".lifeboat-archive-"
+_DIGEST = re.compile(r"[0-9a-f]{64}\Z")
+_RESERVED = {"con", "prn", "aux", "nul", "clock$", "conin$", "conout$"}
+_RESERVED.update(f"{prefix}{number}" for prefix in ("com", "lpt")
+                 for number in ("1", "2", "3", "4", "5", "6", "7", "8", "9", "¹", "²", "³"))
+
+
+class ArchiveError(ValueError):
+    pass
+
+
+def storage_option(value=None):
+    value = "files" if value is None else value
+    if value not in {"files", STORAGE}:
+        raise ArchiveError("projectStorage must be 'files' or 'archive-blocks-v1'")
+    return value
+
+
+def is_archived(project):
+    return isinstance(project.get("storage"), dict) and project["storage"].get("kind") == STORAGE
+
+
+def _integer(value, label, minimum=0, maximum=(1 << 63) - 1):
+    if type(value) is not int or not minimum <= value <= maximum:
+        raise ArchiveError(f"Invalid archive {label}")
+    return value
+
+
+def safe_relative(value, allow_root=False):
+    if not isinstance(value, str) or (not value and not allow_root):
+        raise ArchiveError("Archive path must be a nonempty relative string")
+    if value == "" and allow_root:
+        return value
+    if "\\" in value or value.startswith("/") or value.endswith("/"):
+        raise ArchiveError(f"Noncanonical archive path: {value!r}")
+    try:
+        if len(value.encode("utf-16-le")) > 65520:
+            raise ArchiveError("Archive path exceeds the portable path limit")
+        value.encode("utf-8", "strict")
+    except UnicodeError as exc:
+        raise ArchiveError("Invalid Unicode in archive path") from exc
+    for part in value.split("/"):
+        if (part in {"", ".", ".."} or part.endswith((" ", "."))
+                or any(ord(char) < 32 or ord(char) == 127 or char in '<>:"|?*' for char in part)
+                or part.split(".", 1)[0].casefold() in _RESERVED
+                or part.casefold().startswith(TEMP_PREFIX)
+                or len(part.encode("utf-16-le")) > 510):
+            raise ArchiveError(f"Unsafe or reserved archive path component: {part!r}")
+    return value
+
+
+def _reparse(info):
+    return bool(getattr(info, "st_file_attributes", 0) & 0x400)
+
+
+def _regular_info(path, directory=False):
+    info = Path(path).lstat()
+    expected = stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)
+    if not expected or _reparse(info):
+        raise ArchiveError(f"Links and special files are not supported in archives: {path}")
+    if not directory and getattr(info, "st_nlink", 1) > 1:
+        raise ArchiveError(f"Hard-linked files are not supported in archives: {path}")
+    if stat.S_IMODE(info.st_mode) & ~0o777:
+        raise ArchiveError(f"Special permission bits are not supported in archives: {path}")
+    return info
+
+
+def _windows_streams(path):
+    """Enumerate NTFS streams without opening or copying their contents."""
+    import ctypes
+    from ctypes import wintypes
+
+    class StreamData(ctypes.Structure):
+        _fields_ = [("size", ctypes.c_longlong), ("name", wintypes.WCHAR * 296)]
+
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    first = kernel.FindFirstStreamW
+    first.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, ctypes.POINTER(StreamData), wintypes.DWORD]
+    first.restype = wintypes.HANDLE
+    next_stream = kernel.FindNextStreamW
+    next_stream.argtypes = [wintypes.HANDLE, ctypes.POINTER(StreamData)]
+    next_stream.restype = wintypes.BOOL
+    close = kernel.FindClose
+    close.argtypes = [wintypes.HANDLE]
+    close.restype = wintypes.BOOL
+    absolute = os.path.abspath(path)
+    if not absolute.startswith("\\\\?\\"):
+        absolute = "\\\\?\\UNC\\" + absolute[2:] if absolute.startswith("\\\\") else "\\\\?\\" + absolute
+    data = StreamData()
+    handle = first(absolute, 0, ctypes.byref(data), 0)
+    if handle == ctypes.c_void_p(-1).value:
+        error = ctypes.get_last_error()
+        if error == 38:  # ERROR_HANDLE_EOF: no named/default streams.
+            return []
+        raise ArchiveError(f"Cannot verify that the source has no alternate data streams (Windows error {error}): {path}")
+    result = []
+    try:
+        while True:
+            result.append(data.name)
+            if not next_stream(handle, ctypes.byref(data)):
+                error = ctypes.get_last_error()
+                if error != 38:
+                    raise ArchiveError(f"Cannot finish alternate-stream inspection (Windows error {error}): {path}")
+                break
+    finally:
+        close(handle)
+    return result
+
+
+def _supported_source_metadata(path, info):
+    if getattr(info, "st_file_attributes", 0) & 0x4000:  # FILE_ATTRIBUTE_ENCRYPTED
+        raise ArchiveError(f"EFS-encrypted files/directories cannot be archived with this metadata contract: {path}")
+    if os.name == "nt" and any(name != "::$DATA" for name in _windows_streams(path)):
+        raise ArchiveError(f"Alternate data streams are not supported in project archives: {path}")
+    if hasattr(os, "listxattr"):
+        try:
+            attributes = os.listxattr(path, follow_symlinks=False)
+        except OSError as exc:
+            if exc.errno in {errno.ENOTSUP, errno.EOPNOTSUPP}:
+                attributes = []
+            else:
+                raise
+        if attributes:
+            raise ArchiveError(f"Extended attributes/ACLs are not supported in project archives: {path}")
+
+
+def _metadata(path, relative, kind, info=None):
+    info = info or _regular_info(path, directory=kind == "directory")
+    return {"path": safe_relative(relative, allow_root=kind == "directory"),
+            "kind": kind, "mode": stat.S_IMODE(info.st_mode), "mtimeNs": info.st_mtime_ns}
+
+
+def _physical_path(root, relative):
+    """Resolve a package member without following links/reparse points."""
+    safe_relative(relative)
+    root = Path(root)
+    current = root
+    for number, component in enumerate(relative.split("/")):
+        current = current / component
+        info = current.lstat()
+        if _reparse(info) or stat.S_ISLNK(info.st_mode):
+            raise ArchiveError(f"Archive package path contains a link: {current}")
+        if number < len(relative.split("/")) - 1 and not stat.S_ISDIR(info.st_mode):
+            raise ArchiveError(f"Archive package parent is not a directory: {current}")
+    if not stat.S_ISREG(info.st_mode):
+        raise ArchiveError(f"Archive block is not a regular file: {current}")
+    return current
+
+
+def _prefix(project):
+    value = safe_relative(project.get("backupRelativePath"))
+    if len(value.split("/")) != 2 or not value.startswith("projects/root-"):
+        raise ArchiveError("Archived projects must use distinct projects/root-* payload roots")
+    return value
+
+
+def _block_prefix(prefix):
+    return "project-archives/" + hashlib.sha256(prefix.encode("utf-8")).hexdigest()[:24]
+
+
+def block_paths(project):
+    prefix = _prefix(project)
+    storage = project.get("storage")
+    if not isinstance(storage, dict) or set(storage) != {"kind", "blocks", "metadata"}:
+        raise ArchiveError("Invalid archived-project storage descriptor")
+    if storage["kind"] != STORAGE or storage["metadata"] != "mode-mtime-ns-v1":
+        raise ArchiveError("Unsupported project archive storage or metadata version")
+    blocks = storage["blocks"]
+    if not isinstance(blocks, list) or not blocks or len(blocks) > 1_000_000:
+        raise ArchiveError("Invalid archive block list")
+    for number, path in enumerate(blocks):
+        if path != f"{_block_prefix(prefix)}/block-{number:06d}.zip":
+            raise ArchiveError("Archive block names must be canonical, ordered and bound to their project")
+    return blocks
+
+
+class _PathRegistry:
+    """Detect duplicates and Windows case/type collisions using bounded RAM."""
+    def __enter__(self):
+        self.folder = tempfile.TemporaryDirectory(prefix="lb-archive-names-")
+        try:
+            self.db = sqlite3.connect(Path(self.folder.name) / "names.sqlite")
+            self.db.execute("PRAGMA cache_size=-2048")
+            self.db.execute("CREATE TABLE names (key TEXT PRIMARY KEY, path TEXT NOT NULL, kind TEXT NOT NULL)")
+        except BaseException:
+            self.folder.cleanup()
+            raise
+        return self
+
+    def add(self, entry):
+        path, kind = entry["path"], entry["kind"]
+        safe_relative(path, allow_root=kind == "directory")
+        if path:
+            parent = path.rpartition("/")[0]
+            row = self.db.execute("SELECT path,kind FROM names WHERE key=?", (parent.casefold(),)).fetchone()
+            if row != (parent, "directory"):
+                raise ArchiveError(f"Archive parent is missing, differently cased or not a directory: {path}")
+        elif kind != "directory":
+            raise ArchiveError("Archive root must be a directory")
+        try:
+            self.db.execute("INSERT INTO names VALUES (?,?,?)", (path.casefold(), path, kind))
+        except sqlite3.IntegrityError as exc:
+            raise ArchiveError(f"Duplicate or case-colliding archive path: {path}") from exc
+
+    def __exit__(self, *_):
+        self.db.close()
+        self.folder.cleanup()
+
+
+def _walk_source(source, excludes, warnings):
+    source = Path(source)
+    stack = [(source, "")]
+    excluded = [str(value).replace("\\", "/").casefold() for value in excludes]
+    while stack:
+        current, relative = stack.pop()
+        info = _regular_info(current, directory=True)
+        _supported_source_metadata(current, info)
+        yield current, _metadata(current, relative, "directory", info)
+        with os.scandir(current) as scan:
+            children = sorted(scan, key=lambda entry: (entry.name.casefold(), entry.name))
+        directories = []
+        for entry in children:
+            rel = f"{relative}/{entry.name}" if relative else entry.name
+            if any(fragment and fragment in rel.casefold() for fragment in excluded):
+                warnings.append(f"Excluded by configuration: {entry.path}")
+                continue
+            safe_relative(rel)
+            path = Path(entry.path)
+            info = path.lstat()
+            if stat.S_ISDIR(info.st_mode) and not _reparse(info):
+                directories.append((path, rel))
+            else:
+                info = _regular_info(path)
+                yield path, _metadata(path, rel, "file", info)
+        stack.extend(reversed(directories))
+
+
+def _source_unchanged(before, after):
+    return all(getattr(before, field) == getattr(after, field)
+               for field in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_mode"))
+
+
+def _space_for_archive(path, pending=CHUNK_BYTES):
+    free = shutil.disk_usage(Path(path).parent).free
+    if free < pending + 100 * 1024 * 1024:
+        raise OSError(28, "Insufficient free space while writing a project archive")
+
+
+def pack_project(source, package_root, logical_prefix, excludes=(), warnings=None,
+                 skip_unreadable=None, on_progress=None, block_bytes=MAX_BLOCK_BYTES,
+                 block_entries=MAX_BLOCK_ENTRIES):
+    """Archive a project directly; no intermediate file-by-file backup tree."""
+    _integer(block_bytes, "block byte limit", 1, MAX_BLOCK_BYTES)
+    _integer(block_entries, "block entry limit", 1, MAX_BLOCK_ENTRIES)
+    source, package_root = Path(source), Path(package_root)
+    _prefix({"backupRelativePath": logical_prefix})
+    if package_root.resolve().is_relative_to(source.resolve()):
+        raise ArchiveError("Archive destination must not be inside its source project")
+    warnings = warnings if warnings is not None else []
+    output = package_root / _block_prefix(logical_prefix)
+    output.mkdir(parents=True, exist_ok=False)
+    blocks, entries = [], []
+    archive = None
+    block_size = index_size = count = size = 0
+    last_probe = 0.0
+
+    def finish_block():
+        nonlocal archive, entries, block_size, index_size
