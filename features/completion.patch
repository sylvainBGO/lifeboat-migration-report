+        self.assertEqual(str(self.app.resume_ready_button['state']), 'disabled')
+        with patch.object(self.app, '_run', side_effect=AssertionError('concurrent restore')):
+            self.app._start_loaded_resume()
+        with patch.object(self.app, '_begin_operation', side_effect=AssertionError('concurrent operation')):
+            self.app._run(lambda: None, lambda result: None, 'restore')
+
+    def test_new_operation_replaces_offline_startup_candidate(self):
+        from codex_transfer.resume_discovery import ResumeCandidate
+        old = ResumeCandidate(Path('C:/old/resume-plan.json'), Path('C:/offline'),
+                              Path.home(), 'paused', 1, False)
+        self.app._select_resume(old)
