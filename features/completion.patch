+"""Archive format safety, metadata and durable extraction acceptance tests."""
+import argparse
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import sqlite3
+import stat
+import struct
+import sys
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+import zipfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from codex_transfer import project_archives as archives
+from codex_transfer.restore_checkpoint import CopyCheckpoint, RestorePaused
+from codex_transfer.manifest_index import ManifestIndex
+
+
+class ArchiveTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="lb-archives-")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.source = self.root / "source"
+        self.source.mkdir()
+        (self.source / "folder" / "empty").mkdir(parents=True)
+        (self.source / "zero.txt").write_bytes(b"")
+        (self.source / "readonly.bin").write_bytes(b"a\x00b" * 200)
+        (self.source / "folder" / "François-Łyjak.txt").write_text("data\n" * 50, encoding="utf-8")
+        os.chmod(self.source / "readonly.bin", 0o444)
+        self.stamp = 1_700_000_000_123_456_700
+        for item in [*self.source.rglob("*"), self.source]:
+            os.utime(item, ns=(self.stamp, self.stamp))
+        self.package = self.root / "package"
+        self.package.mkdir()
+        self.destination = self.root / "staging"
+        self.project = None
+
+    def pack(self, **kwargs):
+        count, size, storage = archives.pack_project(
+            self.source, self.package, "projects/root-test", **kwargs)
+        self.project = {"id": "test", "backupRelativePath": "projects/root-test",
+                        "fileCount": count, "totalBytes": size, "storage": storage}
+        self.rows = list(archives.logical_rows(self.package, [self.project]))
+        self.write_manifest()
+        return self.project
+
+    def write_manifest(self):
+        rows = list(self.rows)
+        for relative in archives.block_paths(self.project):
+            path = self.package / relative
+            rows.append({"relative_path": relative, "size": path.stat().st_size,
+                         "sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
+        folder = self.package / "manifest"
+        folder.mkdir(exist_ok=True)
+        with (folder / "sha256.csv").open("w", encoding="utf-8", newline="") as handle:
+            writer = csv.DictWriter(handle, fieldnames=["relative_path", "size", "sha256"])
+            writer.writeheader()
+            writer.writerows(rows)
+        self.hashes = {row["relative_path"]: (row["size"], row["sha256"]) for row in rows}
+
+    def probe(self, *_):
+        return 10**12, 4096
+
+    def extract(self, **kwargs):
+        return archives.extract_project(self.package, self.project, self.destination, self.probe, **kwargs)
+
+    def rewrite_block(self, change, block=0):
+        path = self.package / archives.block_paths(self.project)[block]
+        with zipfile.ZipFile(path) as archive:
+            data = {info.filename: archive.read(info) for info in archive.infolist()}
+        index = json.loads(data[archives.INDEX_NAME])
+        change(index, data)
+        data[archives.INDEX_NAME] = json.dumps(index, ensure_ascii=False).encode("utf-8")
+        with zipfile.ZipFile(path, "w", zipfile.ZIP_STORED) as archive:
+            for name, content in data.items():
+                archive.writestr(name, content)
+        self.write_manifest()
+
+    def test_roundtrip_preserves_content_modes_exact_mtime_and_empty_directories(self):
+        self.pack(block_entries=2, block_bytes=256)
+        self.assertGreater(len(self.project["storage"]["blocks"]), 1)
+        self.assertFalse((self.package / self.project["backupRelativePath"]).exists())
+        count, size = self.extract()
+        self.assertEqual((count, size), (self.project["fileCount"], self.project["totalBytes"]))
+        for source in self.source.rglob("*"):
+            target = self.destination / source.relative_to(self.source)
+            self.assertEqual(target.is_dir(), source.is_dir())
+            self.assertEqual(target.stat().st_mtime_ns, source.stat().st_mtime_ns)
+            if source.is_file():
+                self.assertEqual(target.read_bytes(), source.read_bytes())
+                mask = 0o222 if os.name == "nt" else 0o777
+                self.assertEqual(stat.S_IMODE(target.stat().st_mode) & mask,
+                                 stat.S_IMODE(source.stat().st_mode) & mask)
+        archives.verify_metadata(self.package, self.project, self.destination)
+
+    def test_empty_project_is_not_lost(self):
+        os.chmod(self.source / "readonly.bin", stat.S_IRUSR | stat.S_IWUSR)
+        shutil.rmtree(self.source)
+        (self.source / "still-empty").mkdir(parents=True)
+        self.pack()
+        self.assertEqual(self.extract(), (0, 0))
+        self.assertTrue((self.destination / "still-empty").is_dir())
+        archives.verify_metadata(self.package, self.project, self.destination)
+
+    def test_block_indexes_and_logical_hashes_validate_without_materializing_files(self):
+        self.pack(block_entries=2)
+        result = archives.inspect_package(self.package,
+            {"formatVersion": "2.5", "projectStorage": archives.STORAGE}, [self.project], self.hashes)
+        self.assertEqual(result["hashesChecked"], self.project["fileCount"])
+        self.assertEqual(result["files"], {row["relative_path"] for row in self.rows})
+        self.assertFalse(self.destination.exists())
+        self.assertFalse((self.package / "projects").exists())
+
+    def test_inventory_presence_uses_validated_archive_and_matching_project_identity(self):
+        from codex_transfer.validate import _inventoried_project_payload_present
+        self.pack()
+        validated = archives.inspect_package(self.package,
+            {"formatVersion": "2.5", "projectStorage": archives.STORAGE}, [self.project], self.hashes)
+        item = {"rootId": self.project["id"], "backupRelativePath": self.project["backupRelativePath"]}
+        projects = {self.project["id"]: self.project}
+        self.assertFalse((self.package / item["backupRelativePath"]).exists())
+        self.assertTrue(_inventoried_project_payload_present(self.package, item, projects, validated))
+        self.assertFalse(_inventoried_project_payload_present(self.package, item, projects, {"projects": {}}))
+        for changed in ({**item, "rootId": "other-project"},
+                        {**item, "backupRelativePath": "projects/root-other"},
+                        {**item, "backupRelativePath": "../escape"}):
+            self.assertFalse(_inventoried_project_payload_present(self.package, changed, projects, validated))
+        plain_project = {key: value for key, value in self.project.items() if key != "storage"}
+        plain_projects = {self.project["id"]: plain_project}
+        self.assertFalse(_inventoried_project_payload_present(self.package, item, plain_projects, validated))
+        (self.package / item["backupRelativePath"]).mkdir(parents=True)
+        self.assertTrue(_inventoried_project_payload_present(self.package, item, plain_projects, {"projects": {}}))
+
+    def test_legacy_format_cannot_silently_accept_archive_extension(self):
+        self.pack()
+        with self.assertRaisesRegex(archives.ArchiveError, "requires package format"):
+            archives.inspect_package(self.package, {"formatVersion": "2.4"}, [self.project], self.hashes)
+        result = archives.inspect_package(self.package, {"formatVersion": "2.4"}, [], {})
+        self.assertEqual(result["files"], set())
+
+    def test_pause_records_completed_files_and_resume_does_not_extract_them_again(self):
+        self.pack(block_entries=2)
+        ledger = self.root / "copy.sqlite"
+        virtual = self.package / self.project["backupRelativePath"]
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint:
+            def progress(count, size):
+                if count == 1:
+                    checkpoint.request_pause()
+            with self.assertRaises(RestorePaused):
+                self.extract(checkpoint=checkpoint, on_progress=progress)
+            completed = {row[0] for row in checkpoint._db.execute("SELECT path FROM completed")}
+        self.assertEqual(len(completed), 1)
+        original = archives._member_chunks
+        seen = []
+        def read(archive, entry):
+            seen.append(entry["path"])
+            return original(archive, entry)
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint, \
+             patch.object(archives, "_member_chunks", read):
+            self.extract(checkpoint=checkpoint)
+        self.assertTrue(completed.isdisjoint(seen))
+        archives.verify_metadata(self.package, self.project, self.destination)
+
+    def test_space_guard_prevents_first_write_and_partial_file_is_not_checkpointed(self):
+        self.pack()
+        with self.assertRaises(RestorePaused):
+            archives.extract_project(self.package, self.project, self.destination,
+                                     lambda *_: (_ for _ in ()).throw(RestorePaused("low space")))
+        self.assertFalse(self.destination.exists())
+        ledger = self.root / "copy.sqlite"
+        virtual = self.package / self.project["backupRelativePath"]
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint, \
+             patch.object(archives.os, "fsync", side_effect=OSError(28, "disk full")):
+            with self.assertRaises(OSError):
+                self.extract(checkpoint=checkpoint)
+            self.assertEqual(checkpoint._db.execute("SELECT count(*) FROM completed").fetchone()[0], 0)
+        self.assertFalse(list(self.destination.rglob(archives.TEMP_PREFIX + "*")))
+        with CopyCheckpoint(ledger, virtual, self.destination) as checkpoint:
+            self.extract(checkpoint=checkpoint)
