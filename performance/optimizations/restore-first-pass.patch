+"""Portable component tests; full restore integration must also run on Windows."""
+import csv
+import importlib.util
+from pathlib import Path, PureWindowsPath
+import tempfile
+import unittest
+import sys
+import threading
+import time
+import shutil
+import random
+from unittest.mock import patch
+
+SOURCE = Path(__file__).resolve().parents[1] / 'src' / 'codex_transfer'
+
+
+def module(name):
+    spec = importlib.util.spec_from_file_location(name, SOURCE / (name + '.py'))
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+Budget = module('space_budget').CopySpaceBudget
+Index = module('manifest_index').ManifestIndex
+Replacer = module('text_replace').OrderedPathReplacer
+sys.path.insert(0, str(SOURCE.parent))
+from codex_transfer.parallel_copy import copy_staging_tree
+
+
+class SpaceTests(unittest.TestCase):
+    def budget(self, credit=10**9):
+        self.calls = []
+        self.now = 0
+        self.credit = credit
+
+        def probe(target, size, files):
+            self.calls.append((target, size, files))
+            if self.credit < size + 4096:
+                raise RuntimeError('insufficient space')
+            return self.credit, 4096
+
+        return Budget(probe, clock=lambda: self.now)
+
+    def copy(self, guard, size=1024, target='C:/output/file'):
+        guard(None, PureWindowsPath(target), size)
+
+    def test_small_files_are_batched(self):
+        guard = self.budget()
+        for _ in range(5003):
+            self.copy(guard)
+        self.assertEqual(len(self.calls), 5)
+
+    def test_credit_includes_allocation_and_reserve(self):
+        guard = self.budget(5120)
+        self.copy(guard)
+        self.credit = 0  # first file consumed the budget above the reserve
+        with self.assertRaisesRegex(RuntimeError, 'insufficient'):
+            self.copy(guard)
+        self.assertEqual(len(self.calls), 2)
+
+    def test_external_consumption_detected_on_time_sample(self):
+        guard = self.budget()
+        self.copy(guard)
+        self.now = 1.01
+        self.credit = 0
+        with self.assertRaises(RuntimeError):
+            self.copy(guard)
+
+    def test_large_pending_file_checked_before_write(self):
+        guard = self.budget(300 * 1024**2)
+        self.copy(guard)
+        self.credit = 200 * 1024**2
+        with self.assertRaises(RuntimeError):
+            self.copy(guard, size=256 * 1024**2)
+
+    def test_volume_change_checks_again(self):
+        guard = self.budget()
+        self.copy(guard)
+        self.copy(guard, target='D:/output/file')
+        self.assertEqual(len(self.calls), 2)
+
+
+class ManifestTests(unittest.TestCase):
+    def test_index_used_for_both_selectors_and_cleaned(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            (root / 'manifest').mkdir()
+            manifest = root / 'manifest/sha256.csv'
+            with manifest.open('w', newline='', encoding='utf-8') as handle:
+                writer = csv.writer(handle)
+                writer.writerow(['relative_path', 'size', 'sha256'])
+                writer.writerows([
+                    ('projects/a/x', '1', 'AA'),
+                    ('projects/ab/x', '2', 'BB'),
+                    ('projects/a/x', '3', 'CC'),
+                    ('projects/a/é\n日本', '4', 'DD'),
+                ])
+            with Index(root, directory=root) as index:
+                manifest.unlink()  # no CSV reopen during either selection
+                project = {'backupRelativePath': 'projects/a'}
+                self.assertEqual(index.select(project),
+                                 {'x': (3, 'cc'), 'é\n日本': (4, 'dd')})
+                self.assertEqual(dict(index.hashes(project)),
+                                 {'x': 'cc', 'é\n日本': 'dd'})
+                self.assertEqual(index.select({'backupRelativePath': 'missing'}), {})
+            self.assertEqual(list(root.iterdir()), [root / 'manifest'])
+
+    def test_parse_failure_cleans_index(self):
+        with tempfile.TemporaryDirectory() as folder:
+            with self.assertRaises(FileNotFoundError):
+                Index(folder, directory=folder)
+            self.assertEqual(list(Path(folder).iterdir()), [])
+
+
+class ParallelTests(unittest.TestCase):
+    def fixture(self, root, count=40):
+        source = root / 'source'
+        (source / 'empty').mkdir(parents=True)
+        for i in range(count):
+            path = source / ('d' + str(i % 3)) / (str(i) + '.bin')
+            path.parent.mkdir(exist_ok=True)
+            path.write_bytes(bytes([i % 256]) * (i + 1))
+        return source
+
+    def test_copies_bytes_metadata_and_empty_dirs_with_bounded_writers(self):
+        active = peak = 0
+        lock = threading.Lock()
+        def copy(source, target):
+            nonlocal active, peak
+            with lock:
+                active += 1
+                peak = max(peak, active)
+            try:
+                time.sleep(.003)
+                shutil.copy2(source, target)
+            finally:
+                with lock:
+                    active -= 1
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = self.fixture(root)
+            target = root / 'target'
+            count, size = copy_staging_tree(source, target,
+                lambda *args: (10**9, 4096), copy=copy)
+            self.assertEqual((count, size), (40, sum(range(1, 41))))
+            self.assertGreater(peak, 1)
+            self.assertLessEqual(peak, 4)
+            self.assertEqual(active, 0)
+            self.assertTrue((target / 'empty').is_dir())
+            for file in source.rglob('*.bin'):
+                other = target / file.relative_to(source)
+                self.assertEqual(file.read_bytes(), other.read_bytes())
+                self.assertEqual(file.stat().st_mtime_ns, other.stat().st_mtime_ns)
+
+    def test_failure_drains_workers_before_return(self):
+        active = 0
+        lock = threading.Lock()
+        def copy(source, target):
+            nonlocal active
+            with lock:
+                active += 1
+            try:
+                if Path(source).name == '0.bin':
+                    raise OSError('injected copy failure')
+                time.sleep(.01)
+                shutil.copy2(source, target)
+            finally:
+                with lock:
+                    active -= 1
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = self.fixture(root)
+            with self.assertRaisesRegex(OSError, 'injected'):
+                copy_staging_tree(source, root/'target',
+                    lambda *args: (10**9, 4096), copy=copy)
+            self.assertEqual(active, 0)
+
+    def test_refresh_reserves_inflight_files(self):
+        calls = []
+        release = threading.Event()
+        def probe(target, size, files):
+            calls.append((size, files))
+            if len(calls) == 2:
+                release.set()
+                raise OSError('space limit')
+            return 4097, 4096
+        def copy(source, target):
+            if not release.wait(3):
+                raise AssertionError('coordinator did not refresh')
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = self.fixture(root, 2)
+            with self.assertRaisesRegex(OSError, 'space limit'):
+                copy_staging_tree(source, root/'target', probe, copy=copy)
+            self.assertEqual(calls[1], (3, 2))
+
+    def test_mkdir_only_per_directory(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = self.fixture(root)
+            original = Path.mkdir
+            calls = []
+            def mkdir(path, *args, **kwargs):
+                calls.append(path)
+                return original(path, *args, **kwargs)
+            with patch.object(Path, 'mkdir', mkdir):
+                copy_staging_tree(source, root/'target', lambda *args: (10**9, 4096))
+            self.assertEqual(len(calls), 5)  # root, empty, d0, d1, d2
+
+
+class TextTests(unittest.TestCase):
+    def test_order_cascade_unicode_slashes_and_empty(self):
+        pairs = [('C:/old/deep', 'D:/stage'), ('D:/stage', 'E:/final'),
+                 ('C:/old', 'X:/new'), ('日本', 'é')]
+        for text in ('C:/old/deep/file C:/old/file 日本', 'plain text', '', 'D:/stage'):
+            expected = text
+            for old, new in pairs:
+                expected = expected.replace(old, new)
+            self.assertEqual(Replacer(pairs)(text), expected)
+        self.assertEqual(Replacer([])('plain'), 'plain')
+
+    def test_randomized_equivalence(self):
+        rng = random.Random(31415)
+        for _ in range(1000):
+            pairs = [(''.join(rng.choices('abc/é', k=rng.randint(1, 6))),
+                      ''.join(rng.choices('abc/é', k=rng.randint(0, 6))))
+                     for _ in range(8)]
+            text = ''.join(rng.choices('abc/é', k=80))
+            expected = text
+            for old, new in pairs:
+                expected = expected.replace(old, new)
+            self.assertEqual(Replacer(pairs)(text), expected)
+
+
+if __name__ == '__main__':
+    unittest.main()
