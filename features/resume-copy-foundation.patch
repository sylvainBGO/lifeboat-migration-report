+"""UI state and Defender command contracts, without changing host protection."""
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+
+
+@unittest.skipUnless(os.name == 'nt', 'Windows Tk UI')
+class FeatureUITests(unittest.TestCase):
+    def setUp(self):
+        from codex_transfer.gui import TransferApp
+        self.app = TransferApp()
+        self.app.withdraw()
+        self.addCleanup(self.app.destroy)
+
+    def test_preflight_does_not_mark_projects_copied(self):
+        self.app._begin_operation('restore')
+        self.app._set_busy(True)
+        self.app._apply_progress(50, 100, 'Pre-restore check: Validating backup')
+        self.assertLess(float(self.app.progress.cget('value')), 15)
+        self.assertNotEqual(self.app.stage_dots[1].cget('text'), '✓')
+
+    def test_defender_prompt_is_nonmodal_and_does_not_pause_worker(self):
+        self.app.busy = True
+        self.app.defender_last_state = False
+        self.app._recovery_message('defender_hourly', {'RealTimeProtectionEnabled': True})
+        self.assertTrue(self.app.busy)
+        self.assertFalse(self.app.pause_event.is_set())
+        self.assertIsNone(self.app.grab_current())
+        self.assertTrue(self.app.defender_prompt.winfo_exists())
+
+    def test_animation_does_not_change_status_text_or_widget_geometry(self):
+        self.app._begin_operation('restore')
+        self.app._set_busy(True)
+        self.app._apply_progress(0, 0, 'Reading a long stage...')
+        self.app.update_idletasks()
+        text = self.app.status_label.cget('text')
+        widths = [dot.winfo_reqwidth() for dot in self.app.stage_dots]
+        self.app._tick_operation_clock()
+        self.app.update_idletasks()
+        self.assertEqual(text, self.app.status_label.cget('text'))
+        self.assertEqual(widths, [dot.winfo_reqwidth() for dot in self.app.stage_dots])
+
+    def test_hourly_check_reads_status_without_disabling(self):
+        from codex_transfer import defender_control
+        with patch.object(defender_control, 'request_disable', side_effect=AssertionError('automatic disable')):
+            self.app._recovery_message('defender_hourly', {'RealTimeProtectionEnabled': True})
+        self.assertFalse(self.app.pause_event.is_set())
+
+
+class DefenderContractTests(unittest.TestCase):
+    def test_disable_uses_runas_and_then_checks_real_state(self):
+        from codex_transfer import defender_control
+        with patch.object(defender_control.subprocess, 'CREATE_NO_WINDOW', 0, create=True), \
+             patch.object(defender_control.subprocess, 'run') as run, \
+             patch.object(defender_control, 'status', return_value={'RealTimeProtectionEnabled': True}):
+            run.return_value.returncode = 0
+            result = defender_control.request_disable()
+        command = run.call_args.args[0][-1]
+        self.assertIn('-Verb RunAs', command)
+        self.assertIn('Set-MpPreference -DisableRealtimeMonitoring $true', command)
+        self.assertNotIn('DisableTamper', command)
+        self.assertTrue(result['RealTimeProtectionEnabled'])
