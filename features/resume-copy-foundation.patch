@@ -0,0 +1,150 @@
+"""Recovery primitives: real copies, interruption, lock and restart boundaries."""
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from codex_transfer.parallel_copy import copy_staging_tree
+from codex_transfer.restore_checkpoint import (
+    CopyCheckpoint, RestorePaused, CheckpointBusy, PAUSE_RESERVE_BYTES,
+)
+
+
+class CheckpointTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.source = self.root / 'source'
+        self.target = self.root / 'stage'
+        self.path = self.root / 'copy.sqlite'
+        self.source.mkdir()
+        for n in range(40):
+            (self.source / str(n)).write_bytes(bytes([n]) * (n + 1))
+
+    def ledger(self, **kwargs):
+        return CopyCheckpoint(self.path, self.source, self.target, **kwargs)
+
+    def probe(self, *_):
+        return 10**9, 4096
+
+    def test_manual_pause_drains_then_resume_never_recopies_completed(self):
+        copied = []
+        lock = threading.Lock()
+        with self.ledger() as checkpoint:
+            def copy(source, target):
+                shutil.copy2(source, target)
+                with lock:
+                    copied.append(Path(source).name)
+                checkpoint.request_pause()
+
+            with self.assertRaises(RestorePaused):
+                copy_staging_tree(self.source, self.target, self.probe,
+                                  checkpoint=checkpoint, copy=copy)
+            finished = set(copied)
+            self.assertGreater(len(finished), 0)
+            self.assertLess(len(finished), 40)
+            self.assertEqual(checkpoint.summary()['files'], len(finished))
+        # Reopening the on-disk document is independent of the old event/object.
+        with self.ledger() as checkpoint:
+            def resumed_copy(source, target):
+                self.assertNotIn(Path(source).name, finished)
+                shutil.copy2(source, target)
+                copied.append(Path(source).name)
+            count, size = copy_staging_tree(
+                self.source, self.target, self.probe,
+                checkpoint=checkpoint, copy=resumed_copy)
+            self.assertEqual((count, size), (40, sum(range(1, 41))))
+            self.assertEqual(len(copied), len(set(copied)))
+        for source in self.source.iterdir():
+            self.assertEqual(source.read_bytes(), (self.target / source.name).read_bytes())
+
+    def test_low_space_pauses_before_any_write_and_can_resume(self):
+        with self.ledger() as checkpoint:
+            probe = checkpoint.space_probe(lambda _: (PAUSE_RESERVE_BYTES, 4096))
+            with self.assertRaises(RestorePaused):
+                copy_staging_tree(self.source, self.target, probe, checkpoint=checkpoint)
+            self.assertEqual(checkpoint.summary()['files'], 0)
+            self.assertEqual(list(self.target.iterdir()), [])
+        with self.ledger() as checkpoint:
+            probe = checkpoint.space_probe(lambda _: (10**9, 4096))
+            self.assertEqual(copy_staging_tree(
+                self.source, self.target, probe, checkpoint=checkpoint)[0], 40)
+
+    def test_reserve_includes_pending_bytes_and_allocation(self):
+        with self.ledger() as checkpoint:
+            minimum = PAUSE_RESERVE_BYTES + 123 + 2 * 4096
+            probe = checkpoint.space_probe(lambda _: (minimum, 4096))
+            self.assertEqual(probe(self.target, 123, 2), (8315, 4096))
+            with self.assertRaises(RestorePaused):
+                probe(self.target, 124, 2)
+
+    def test_low_space_drains_and_records_already_admitted_file(self):
+        with self.ledger() as checkpoint:
+            # Enough for any one fixture file, never enough for two reservations.
+            probe = checkpoint.space_probe(
+                lambda _: (PAUSE_RESERVE_BYTES + 4096 + 40, 4096))
+            with self.assertRaises(RestorePaused):
+                copy_staging_tree(self.source, self.target, probe, checkpoint=checkpoint)
+            self.assertEqual(checkpoint.summary()['files'], 1)
+        with self.ledger() as checkpoint:
+            self.assertEqual(checkpoint.summary()['files'], 1)
+            self.assertEqual(len(list(self.target.iterdir())), 1)
+
+    def test_disk_error_while_pausing_is_not_hidden(self):
+        with self.ledger() as checkpoint:
+            def fail(source, target):
+                checkpoint.request_pause()
+                raise OSError('injected write failure')
+            with self.assertRaisesRegex(OSError, 'injected write failure'):
+                copy_staging_tree(self.source, self.target, self.probe,
+                                  checkpoint=checkpoint, copy=fail)
+            self.assertEqual(checkpoint.summary()['files'], 0)
+
+    def test_binding_rejects_wrong_destination_before_copy(self):
+        with self.ledger() as checkpoint:
+            with self.assertRaises(ValueError):
+                copy_staging_tree(self.source, self.root / 'other', self.probe,
+                                  checkpoint=checkpoint)
+        with self.assertRaises(ValueError):
+            CopyCheckpoint(self.path, self.source, self.root / 'other')
+        # Failed initialization releases its lock.
+        with self.ledger():
+            pass
+
+    def test_one_writer_and_released_lock(self):
+        with self.ledger():
+            with self.assertRaises(CheckpointBusy):
+                self.ledger()
+        with self.ledger():
+            pass
+
+    def test_abrupt_process_exit_keeps_only_committed_batch(self):
+        # Exit without close/finally: SQLite must roll back the unfinished batch,
+        # while the OS releases the lock so another process can resume.
+        script = '''
+import os, sys
+from pathlib import Path
+from codex_transfer.restore_checkpoint import CopyCheckpoint
+root = Path(sys.argv[1])
+ledger = CopyCheckpoint(root/'copy.sqlite', root/'source', root/'stage', batch_size=2)
+for n in range(3):
+    ledger.complete(root/'source'/str(n), n+1)
+os._exit(23)
+'''
+        env = dict(os.environ, PYTHONPATH=str(Path(__file__).resolve().parents[1] / 'src'))
+        result = subprocess.run([sys.executable, '-c', script, str(self.root)],
+                                env=env, capture_output=True, timeout=20)
+        self.assertEqual(result.returncode, 23, result.stderr.decode())
+        with self.ledger() as checkpoint:
+            self.assertEqual(checkpoint.summary(), {'files': 2, 'bytes': 3})
+            self.assertIsNone(checkpoint.done(self.source / '2'))
+
+
+if __name__ == '__main__':
+    unittest.main()
